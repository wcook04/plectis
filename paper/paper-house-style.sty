%
% Shared typography for the rendered Plectis papers.  Under Tectonic (XeTeX)
% the text and mathematics use TeX Gyre Pagella, with Heros for sans-serif
% mathematics and Inconsolata for monospace.  The A4 text block follows a
% classical measure with quiet running heads and restrained link colours.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{paper-house-style}[2026/07/28 Pagella house style for Plectis papers]

\RequirePackage{iftex}
\RequirePackage{amsmath}
\RequirePackage{amsthm}
\ifpdftex
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{amssymb}
  \RequirePackage{newpxtext}
  \RequirePackage{newpxmath}
\else
  \RequirePackage{fontspec}
  \RequirePackage{unicode-math}
  \setmainfont{texgyrepagella}[Extension=.otf,UprightFont=*-regular,
    BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]
  \setmathfont{texgyrepagella-math.otf}
  \setmathfont{texgyreheros-regular.otf}[range=sfup,Scale=MatchLowercase]
  \setmonofont{Inconsolatazi4}[Extension=.otf,UprightFont=*-Regular,
    BoldFont=*-Bold,Scale=MatchLowercase]
\fi

\RequirePackage[a4paper,textwidth=418pt,textheight=636pt,hcentering,
  top=68pt,headheight=15pt,headsep=20pt,footskip=34pt]{geometry}
\RequirePackage{microtype}
\linespread{1.045}
\clubpenalty=10000 \widowpenalty=10000 \tolerance=1600

\RequirePackage[dvipsnames,table]{xcolor}
\definecolor{linkexternal}{HTML}{275D8C}
\definecolor{linkinternal}{HTML}{6E2B2B}
\definecolor{papertableheader}{HTML}{E3EAF0}
\definecolor{papertablerow}{HTML}{F2F5F7}
\definecolor{papertablerule}{HTML}{7D8991}
\definecolor{paperresultrule}{HTML}{315B72}

\RequirePackage{titlesec}
\titleformat{\section}{\Large\bfseries}{\thesection}{0.85em}{}
\titlespacing*{\section}{0pt}{2.6ex plus .8ex minus .3ex}{1.5ex plus .3ex}
\titleformat{\subsection}{\large\bfseries}{\thesubsection}{0.8em}{}
\titlespacing*{\subsection}{0pt}{2.1ex plus .6ex minus .2ex}{1.1ex plus .2ex}
\titlespacing*{\paragraph}{0pt}{1.6ex plus .5ex minus .2ex}{0.85em}

\RequirePackage{fancyhdr}
\newcommand{\paperrunninghead}{}
\newcommand{\runninghead}[1]{\renewcommand{\paperrunninghead}{#1}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\itshape\paperrunninghead}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}}

\RequirePackage{caption}
\captionsetup{font=small,labelfont=bf,skip=9pt,width=.92\linewidth}
\RequirePackage{etoolbox}
\renewcommand{\arraystretch}{1.20}
\newcommand{\papertablehead}{\rowcolor{papertableheader}}
\newcommand{\papertablebody}{\rowcolors{2}{white}{papertablerow}}
\AtBeginEnvironment{tabular}{%
  \papertablebody
  \arrayrulecolor{papertablerule}%
  \setlength{\extrarowheight}{1.4pt}%
}
\AtBeginEnvironment{longtable}{%
  \papertablebody
  \arrayrulecolor{papertablerule}%
  \setlength{\extrarowheight}{1.4pt}%
}

% A compact front-matter panel for the result a scanning reader should retain.
% It is deliberately short and unbreakable: manuscripts should state one
% result, its evidence, and its limit here, then supply the argument below.
\newenvironment{paperresult}[1]{%
  \par\addvspace{0.7em}
  \begin{center}\begin{minipage}{0.94\linewidth}
    {\color{paperresultrule}\rule{\linewidth}{0.8pt}}\par\vspace{4pt}
    {\small\sffamily\bfseries\color{paperresultrule}#1}\par\smallskip
    \small\color{black}
}{%
    \par\vspace{4pt}{\color{paperresultrule}\rule{\linewidth}{0.45pt}}
    \end{minipage}\end{center}\par\addvspace{0.5em}
}

\newcommand{\subtitle}[1]{\gdef\@papersubtitle{#1}}
\renewenvironment{abstract}{%
  \vspace{0.1em}\small
  \begin{center}{\normalsize\scshape Abstract}\end{center}\vspace{-0.5em}
  \list{}{\leftmargin 1.3em\rightmargin\leftmargin\listparindent 0pt
    \parsep 0.32em\itemindent 0pt}\item\relax}
  {\endlist\vspace{0.5em}}
\def\@maketitle{%
  \newpage\null
  \vspace*{-2.6em}%
  \begin{center}%
    {\LARGE\bfseries\@title\par}%
    \vskip 0.55em
    {\large\itshape\@papersubtitle\par}%
    \vskip 1.1em
    {\scshape\@author\textsuperscript{*}\par}%
    \vskip 0.25em
    {\small\@date\par}%
    \vskip 0.8em
    \rule{6.5em}{0.4pt}%
  \end{center}%
  \vskip 0.9em}

\newcommand{\provenancenote}[1]{%
  \begingroup
  \renewcommand{\thefootnote}{*}%
  \footnotetext{#1}%
  \endgroup}

% Corpus-wide production disclosure. The private corpus registry checks these
% exact paragraphs against every rendered active paper.
\newcommand{\paperprovenance}{\provenancenote{\emph{Authorship and AI use.}
Will Cook built and directed the research infrastructure and reviewed the claims
when he could. AI agents did most of the research and drafting. Cook did not
independently verify every claim.}}

\endinput
