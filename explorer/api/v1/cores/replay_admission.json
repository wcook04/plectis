y/_api.py","sha256":"94f3ddd30f07ca337ce2115d74678a190cb84490fa327b1918bb5ec5b1c5ab15"},{"ref":"src/plectis/replay/_generated/ReplayAdmission.py","sha256":"8d12ab6740d52c48048ff64f27b38ce93a56516d6d94c12bd3a2499302b9b96d"},{"ref":"src/plectis/replay/_generated/System_/__init__.py","sha256":"96b6e33c036bc3aeab6d1810c7aef085184d09c407bdec032ea89d7a98843edf"},{"ref":"src/plectis/replay/_generated/__main__.py","sha256":"c4ae6779df0fe169f99586b7b88fa2d885c3acaffcb1322c36db8b326b841090"},{"ref":"src/plectis/replay/_generated/_dafny/__init__.py","sha256":"18d39decdedad0e188456e15d17f1dcd5113c4abc258ad6cb718e39534555e7a"},{"ref":"src/plectis/replay/_generated/module_.py","sha256":"a70f4f6e38631b43bc249928d69eaf530b88ba152a3e92fcda837585b348728c"}],"assumptions":["A nonempty supplied registry slice and honestly extracted host observations."],"core_id":"replay_admission","current_binding":{"assessment_time_basis":"index_generation_only","checker_ref":"scripts/check/check_replay_kernel.py","generated_python":{"ReplayAdmission.py":"8d12ab6740d52c48048ff64f27b38ce93a56516d6d94c12bd3a2499302b9b96d","System_/__init__.py":"96b6e33c036bc3aeab6d1810c7aef085184d09c407bdec032ea89d7a98843edf","__main__.py":"c4ae6779df0fe169f99586b7b88fa2d885c3acaffcb1322c36db8b326b841090","_dafny/__init__.py":"18d39decdedad0e188456e15d17f1dcd5113c4abc258ad6cb718e39534555e7a","module_.py":"a70f4f6e38631b43bc249928d69eaf530b88ba152a3e92fcda837585b348728c"},"source_sha256":{"ReplayAdmission.dfy":"c57d8ccc791bf5e80857c732b15901103a9f9c7caf79993dd6c6642419933aae"},"status":"current_hash_binding_pass"},"entry_theorem_refs":["formal/replay/ReplayAdmission.dfy#AdmissionExact"],"fresh_prover_result":{"status":"not_run_by_index"},"generated_refs":["src/plectis/replay/_generated/ReplayAdmission.py","src/plectis/replay/_generated/System_/__init__.py","src/plectis/replay/_generated/__main__.py","src/plectis/replay/_generated/_dafny/__init__.py","src/plectis/replay/_generated/module_.py"],"guide":{"availability":"available","plain":null,"plain_availability":"unrecorded","ref":"formal/replay/README.md","sha256":"5fa12e084b20eb0b19d376fe2513ebad5d7ad20a56d996aecfc85b7df02d8047","text":"# Component replay admission core\n\n`ReplayAdmission.dfy` checks a batch of host-observed component replays against\nthe supplied registry slice. The slice must be nonempty. For every declared\ncomponent, the generated `Check` requires exactly one matching observation;\nevery observation must match a declared component. This rejects omitted,\nduplicate and unknown routes. The check also requires the selected route,\nrunner and receipt component IDs to agree; the input route, evidence class and\nclaim-contract identity to match the specification; source and input identities\nto remain stable; a parsed receipt with a nonzero byte digest; runner and receipt\nstatuses and verdicts to be `pass`; the producer's public payload digest and the\npersisted receipt payload digest to agree; and the exact declared native witness\nkind to appear in both returned result and receipt.\n\n`AdmissionExact` proves soundness and completeness of the executable decision\nagainst the independent quantified `Admission` relation for every finite\nregistry slice and observation sequence. `UsefulAndAdversarialCases` shows an\nattainable accepted row and concrete missing, duplicate, unknown, stale,\nmismatched, failed and absent-receipt rejections. The coverage and stale input\nmutants in `negative/` weaken the executable decision; the proof checker\nrequires both to fail. No axiom, assumption or external theorem is used.\n\nThe host creates the observation sequence, runs the component, hashes source\nand input trees, captures receipt bytes and strictly parses them. A scoped\nobserver captures the producer's public payload at the shared writer after its\nnormalization and timestamp handling. The host requires one write to the selected\nreceipt path and compares that captured payload with the separately read file.\nIt also checks the raw returned result's identity, status and native evidence,\nand records its digest for audit. Some existing producers deliberately project a\nsmaller public receipt from a larger API result. Payload equality establishes\nwriter-intent agreement with the saved receipt; it does not prove that projection\npreserves every raw result field or correctly expresses the component's claim.\nThe claim and evidence identifiers bind the host\nenvelope to the declared registry policy; legacy component receipts do not\nindependently carry those identifiers. A nonzero digest says only that the host\nsupplied an identity. The host must use a fresh confined output location and\none immutable captured receipt buffer. Host compromise, forged runner result,\ndishonest parser, normalization error, unsupported result semantics and an\nordinary component's bare `pass` remain outside the Dafny claim. The result\nestablishes admission of the observed replay envelope, not correctness of a\ncomponent algorithm or authenticity of execution. Native Lean checks retain\ntheir separate runtime requirements.\n\nThe generated Python in `src/plectis/replay/_generated/` is called by the\n`plectis.replay.accept` adapter through an isolated worker and the shared\nsealed-source loader. Dafny, Boogie, Z3, the compiler/runtime, Python and the\nhost remain trusted. The generated Dafny runtime keeps its upstream MIT\nlicence. The formal source is Apache-2.0.\n\n## Reproduce\n\nInstall the pinned official [Dafny 4.11.0 release](https://github.com/dafny-lang/dafny/releases/tag/v4.11.0).\nThe macOS arm64 archive SHA-256 is recorded in `metadata.json`. From the\nrepository root:\n\n```sh\npython3 scripts/check/check_replay_kernel.py --dafny /absolute/path/to/dafny\nPYTHONPATH=src python3 -m pytest tests/test_replay_kernel.py\n```\n\nThe checker verifies Dafny, regenerates Python into ignored checkout-local\nscratch space, compares every deployed generated byte, and requires both\nmutants to fail. Without `--dafny` it checks only recorded source/generated\nidentities and loader inventory; that mode does not reprove the theorem.\n"},"guide_ref":"formal/replay/README.md","interpretation_provenance":{"assumption_refs":["formal/replay/README.md"],"basis":"authored summary of named formal guides and declarations","limit_refs":["formal/replay/README.md","formal/README.md"],"statement_refs":["formal/README.md","formal/replay/README.md"]},"language":"dafny","limits":["Execution authenticity, component semantics, receipt claim adequacy and filesystem/hash observations are outside the theorem.","Dafny/Boogie/Z3, compiler, generated runtime, Python and host remain trusted."],"metadata_ref":"formal/replay/metadata.json","module":"ReplayAdmission","negative_controls":[{"fresh_result":{"status":"not_run_by_index"},"retained_result":{"basis":"recorded_metadata","errors":2,"verified_tasks":14},"source_ref":"formal/replay/negative/MissingCoverageMutant.dfy","source_sha256":"d3b3e3b5436304bdee313d0968c575cf007e25abe986c592812b3cfe84ea23ac"},{"fresh_result":{"status":"not_run_by_index"},"retained_result":{"basis":"recorded_metadata","errors":3,"verified_tasks":13},"source_ref":"formal/replay/negative/StaleInputMutant.dfy","source_sha256":"3de64ed728cd310db66f55fd100a6d7d51bfd5056d1373be69377d30734203d3"}],"proof_id":"core::dafny::replay_admission","public_caller_refs":["src/plectis/replay/_api.py#accept","src/microcosm_core/component_replay.py#replay_components"],"replay_route_basis":"declared RUNTIME_STEPS; admission is conditional on observations, not a recorded successful run","requirements_review":{"status":"unrecorded"},"retained_verification":{"basis":"recorded_metadata","dafny_version":"4.11.0+fcb2042d6d043a2634f0854338c08feeaaaf4ae2","task_names_status":"unrecorded","tasks":[],"verified_tasks":16},"specification_refs":["formal/replay/ReplayAdmission.dfy"],"statement":"Acceptance is equivalent to complete unique coverage of a nonempty supplied registry with matching component, input, claim-policy, source, public payload and required witness observations."},"schema_version":"plectis_component_http_v1","snapshot_revision":"45be1deb333ad57cd9ae093229455d0a52d3bf23a9064cde09f1a6e16f4c7044"}