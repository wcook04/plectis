034bc188b5bc133ebd31a8c658eb87dca5a73e530cd5ce","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"semantic_validator","family":"work_landing_and_continuity","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_import_validation"},"component_id":"durable_agent_work_landing_replay","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.durable_agent_work_landing_replay","plain":"When an automated assistant says its work was saved to a project's history, its records should back that up. This component is given made-up records of the files claimed, the checks and save attempt, and the project's latest version before and after. It compares each record with a written policy, for example requiring that a claimed save moved the latest version and that the checks ran first. The result passes only if two faulty example records, a claimed save with no change and a save attempted before the checks, are both caught.","plain_availability":"available","ref":"paper_modules/durable_agent_work_landing_replay.md","sha256":"4738492ccfba850b67ec3bb919d7c14f2736e516e40c823d10aac602e5658098","text":"# Recorded work landing: check the evidence\n\n> **In plain terms.** When an automated assistant says its work was saved to a project's history, its records should back that up. This component is given made-up records of the files claimed, the checks and save attempt, and the project's latest version before and after. It compares each record with a written policy, for example requiring that a claimed save moved the latest version and that the checks ran first. The result passes only if two faulty example records, a claimed save with no change and a save attempted before the checks, are both caught.\n\nThis replay checks recorded agent work against a landing policy. It reads claimed paths, validation and commit-attempt references, HEAD before and after, blocker capture, and ledger closeout. It writes result, board, validation and acceptance receipts. It does not perform Git operations.\n\nThe fixture includes a landed claim with no HEAD advance and a commit attempt recorded before validation. Both must be detected for the negative-case matrix to pass. The exported bundle also checks copied source-body digests and required anchors; those checks identify the copied material, not the correctness of its algorithms.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.durable_agent_work_landing_replay run \\\n  --input fixtures/first_wave/durable_agent_work_landing_replay/input \\\n  --out .microcosm/component-guides/durable_agent_work_landing_replay \\\n  --acceptance-out .microcosm/component-guides/durable_agent_work_landing_replay/acceptance.json\n```\n\nThe command prints the fixture status and writes receipts in the specified directory. The explicit acceptance path matters: without it, this runner writes its acceptance receipt to the public-root default. A pass reports that the supplied rows and expected failures meet this contract; it does not prove that a real commit landed or authorize one. The provenance ideas are related to [W3C PROV](https://www.w3.org/TR/prov-overview/) and [SLSA](https://slsa.dev/spec/).\n\n## Verification\n\nThe focused tests exercise the landing rules and source-digest checks; they do not prove the validator algorithm. `make component-replays` runs the exported landing bundle through the [shared Dafny admission check](../formal/replay/README.md), which checks agreement of the observed source, input, claim policy and receipt. The fixture command above does not itself invoke that check.\n\n## Source and evidence\n\n- [Implementation](../src/microcosm_core/organs/durable_agent_work_landing_replay.py) and [focused tests](../tests/test_durable_agent_work_landing_replay.py).\n- [Fixture inputs](../fixtures/first_wave/durable_agent_work_landing_replay/input/); [historical sample result](../receipts/first_wave/durable_agent_work_landing_replay/durable_agent_work_landing_replay_result.json).\n- [JSON record](../paper_modules/durable_agent_work_landing_replay.json); canonical metadata: [`core/paper_module_capsules.json`](../core/paper_module_capsules.json).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/durable_agent_work_landing_replay/exported_work_landing_replay_bundle_validation_result.json","guide_example":{"command":"microcosm durable-agent-work-landing-replay run-work-landing-bundle","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/durable_agent_work_landing_replay.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[durable_agent_work_landing_replay].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":null},"input_mode":"exported_work_landing_replay_bundle","input_ref":"examples/durable_agent_work_landing_replay/exported_work_landing_replay_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/durable_agent_work_landing_replay_fixture_acceptance.json","artifact_sha256":"c6dd738c6c16af6a50100ae2c3875c48860392167ed5b8e5db3d10e55738e702","availability":"available","created_at":"2026-05-26T23:41:57+00:00","freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"durable_agent_work_landing_replay","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["plectis","component-replay","durable_agent_work_landing_replay"],"implementation_state":"companion_external_backend_proposal","input_override_supported":false,"kind":"fixed_component_replay_api","organ_id":"durable_agent_work_landing_replay","output_policy":"fresh ignored .microcosm/component-replays run under selected checkout","scope":"single_registered_component","worker_schema":"plectis_component_replay_worker_v1"},"receipt_name":"exported_work_landing_replay_bundle_validation_result.json","replay_id":"replay::durable_agent_work_landing_replay","runner_ref":"src/microcosm_core/organs/durable_agent_work_landing_replay.py#run_work_landing_bundle","span":"durable_work_landing_replay.validate"},"requirements_reviews":{"records":[],"status":"unrecorded"},"subclaims":[]},"schema_version":"plectis_component_http_v1","snapshot_revision":"45be1deb333ad57cd9ae093229455d0a52d3bf23a9064cde09f1a6e16f4c7044"}