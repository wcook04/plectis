vely_mapped","status":"unknown"}},"claim_text_sha256":"8ca12783ed5b640204de63b67b8e0ac839d6212a927c1cf6d256bef6385b788d","evidence":{"authority_availability":"available","authority_receipt_ref":"receipts/acceptance/first_wave/bounded_autonomy_campaign_packet_fixture_acceptance.json","evidence_class":"external_subprocess_witness","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/bounded_autonomy_campaign_packet/bounded_autonomy_campaign_packet_result.json","receipts/first_wave/bounded_autonomy_campaign_packet/bounded_autonomy_campaign_packet_board.json","receipts/first_wave/bounded_autonomy_campaign_packet/bounded_autonomy_campaign_packet_validation_receipt.json","receipts/acceptance/first_wave/bounded_autonomy_campaign_packet_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.bounded_autonomy_campaign_packet","primary_guide_ref":"paper_modules/bounded_autonomy_campaign_packet.md","registered_runner_ref":"src/microcosm_core/organs/bounded_autonomy_campaign_packet.py","replay_id":"replay::bounded_autonomy_campaign_packet","requirements_review":{"status":"unrecorded"},"summary":"A synthetic campaign fixture drafts review-only candidates.","title":"Draft a bounded campaign packet"},"claim_ceiling":"tool witness only, not general proof authority","claim_ceiling_restated":"Drafts review-only candidates from a synthetic campaign and, in public-only mode, checks the copied source and derives the candidate count from policy, rejecting a repeated failed campaign digest.","claim_id":"claim::bounded_autonomy_campaign_packet","evidence_class":"external_subprocess_witness","evidence_strength_rank":4,"organ_id":"bounded_autonomy_campaign_packet","truth_accounting_bucket":"real_runtime_receipt","validator_command":"python -m microcosm_core.organs.bounded_autonomy_campaign_packet run --input fixtures/first_wave/bounded_autonomy_campaign_packet/input --out receipts/first_wave/bounded_autonomy_campaign_packet --acceptance-out receipts/acceptance/first_wave/bounded_autonomy_campaign_packet_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"493938fca0289f7724ee64e973c33a96849df47b7f689b91fd6463acfd9c4365","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"external_subprocess_witness","family":"agent_reliability_and_safety","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_runtime_receipt"},"component_id":"bounded_autonomy_campaign_packet","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.bounded_autonomy_campaign_packet","plain":"A program that proposes its own work needs firm limits, so a person can review each proposal first. This component is given a made-up list of gaps in what a project checks, a policy of limits and a ledger of failed plans. It drafts candidate work items for people to review, each naming one gap and none allowed to change code, using the project's plan-building tool in read-only mode, which the public copy inspects rather than runs. It blocks a policy that would allow code changes, an empty draft, or a ledger listing the same failed plan more than once.","plain_availability":"available","ref":"paper_modules/bounded_autonomy_campaign_packet.md","sha256":"4a58c5e0e969183a83e8bd5cd8dab3fa897d0ac48ee0144d0780a0391b318313","text":"# Draft a bounded campaign packet\n\n> **In plain terms.** A program that proposes its own work needs firm limits, so a person can review each proposal first. This component is given a made-up list of gaps in what a project checks, a policy of limits and a ledger of failed plans. It drafts candidate work items for people to review, each naming one gap and none allowed to change code, using the project's plan-building tool in read-only mode, which the public copy inspects rather than runs. It blocks a policy that would allow code changes, an empty draft, or a ledger listing the same failed plan more than once.\n\nThis fixture reads synthetic coverage gaps, a campaign policy and a failed-digest ledger, then drafts candidate records for human review. Each candidate names a gap and specifies no source-write surface.\n\nWhen the parent campaign builder is available, the fixture invokes it as a read-only subprocess and uses its candidate count. In a standalone public checkout, it instead checks the copied builder's manifest, digest and required source anchors; the candidate count comes from the policy limit. That source-only witness does not execute the builder. The evaluator blocks a policy that permits `write_source`, a failed witness or empty packet, and duplicate failed campaign digests. A missing copied builder target also blocks the public witness.\n\n## Run the example\n\nPython 3.11 or newer and the project test dependencies (install with `python3 -m pip install -e \".[test]\"`) are required. Run from the repository root:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.bounded_autonomy_campaign_packet run \\\n  --input fixtures/first_wave/bounded_autonomy_campaign_packet/input \\\n  --out .microcosm/component-guides/bounded_autonomy_campaign_packet \\\n  --acceptance-out .microcosm/component-guides/bounded_autonomy_campaign_packet/acceptance.json\n```\n\nThe command writes its result and acceptance files under `.microcosm/component-guides/`; inspect the status and findings in those files.\n\n## Verification\n\nThe source witness and packet checks do not formally prove the campaign builder or its decisions. Separately, `make component-replays` runs this component’s registered exported-bundle route through the [Dafny-proved replay admission check](../formal/replay/README.md). Using host-supplied observations, it compares source, input, claim-policy and receipt identities; it does not prove the component’s domain result. The direct command above does not invoke the shared check.\n\n## Limits\n\nThe packet is a draft for review. The public source-only witness does not establish builder behavior. The fixture does not perform autonomous repair, execute a campaign or authorize source changes.\n\n## Sources\n\n[src/microcosm_core/organs/bounded_autonomy_campaign_packet.py](../src/microcosm_core/organs/bounded_autonomy_campaign_packet.py) contains the implementation. See the [input fixtures](../fixtures/first_wave/bounded_autonomy_campaign_packet/input/), [tests](../tests/test_bounded_autonomy_campaign_packet.py), [historical sample acceptance result](../receipts/acceptance/first_wave/bounded_autonomy_campaign_packet_fixture_acceptance.json), and the [component JSON record](../core/paper_module_capsules.json). Related background: [NIST AI Risk Management Framework](https://www.nist.gov/itl/ai-risk-management-framework).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/bounded_autonomy_campaign_packet/exported_bounded_autonomy_campaign_packet_bundle_validation_result.json","guide_example":{"command":"microcosm bounded-autonomy-campaign-packet run --input fixtures/first_wave/bounded_autonomy_campaign_packet/input --out receipts/first_wave/bounded_autonomy_campaign_packet","expected_result_description":{"status":"unrecorded"},"prerequisites_description