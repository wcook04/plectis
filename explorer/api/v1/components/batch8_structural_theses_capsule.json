7c652ce9177ace978a1d1909ac8b1cd8b01d7890ccc861286fab42798c2a4235","evidence":{"authority_availability":"available","authority_receipt_ref":"receipts/acceptance/first_wave/batch8_structural_theses_capsule_fixture_acceptance.json","evidence_class":"verified_macro_body_import","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/batch8_structural_theses_capsule/batch8_structural_theses_capsule_result.json","receipts/first_wave/batch8_structural_theses_capsule/batch8_structural_theses_capsule_board.json","receipts/first_wave/batch8_structural_theses_capsule/batch8_structural_theses_capsule_validation_receipt.json","receipts/acceptance/first_wave/batch8_structural_theses_capsule_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.batch8_structural_theses_capsule","primary_guide_ref":"paper_modules/batch8_structural_theses_capsule.md","registered_runner_ref":"src/microcosm_core/organs/batch8_structural_theses_capsule.py","replay_id":"replay::batch8_structural_theses_capsule","requirements_review":{"status":"unrecorded"},"summary":"A synthetic thesis family tests losses, controls and forward gates.","title":"Test a structural-thesis family with losses and controls"},"claim_ceiling":"verified non-secret macro body import only, not source authority, private-root equivalence, release, or publication","claim_ceiling_restated":"Runs a synthetic thesis family through loss, control and forward-gate checks, rejecting a survivor-only sample, a promoted refuted pattern and a confirmed negative control.","claim_id":"claim::batch8_structural_theses_capsule","evidence_class":"verified_macro_body_import","evidence_strength_rank":5,"organ_id":"batch8_structural_theses_capsule","truth_accounting_bucket":"copied_non_secret_macro_body","validator_command":"python -m microcosm_core.organs.batch8_structural_theses_capsule run --input fixtures/first_wave/batch8_structural_theses_capsule/input --out receipts/first_wave/batch8_structural_theses_capsule --acceptance-out receipts/acceptance/first_wave/batch8_structural_theses_capsule_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"e74e2d1858b5ae982235243bc5a0a2b186cf029107241b077fe6ea520527f441","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"verified_macro_body_import","family":"import_projection_and_drift","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"copied_non_secret_macro_body"},"component_id":"batch8_structural_theses_capsule","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.batch8_structural_theses_capsule","plain":"A report on investment ideas can look better than it is when it shows only the ideas that worked. This check uses copied finance code to build made-up market claims, including winners, losers and a comparison case that should not count as a success. A validator rejects a set with only winners, and it flags a failed pattern promoted into the ideas to pursue and a comparison case relabeled as a confirmed claim. The output is a status with named findings, which shows whether the rules catch one-sided evidence.","plain_availability":"available","ref":"paper_modules/batch8_structural_theses_capsule.md","sha256":"01b7e877104f983b4d13e5de8518737df0b6dc90d3e14991eb9fa381d32d7f76","text":"# Test a structural-thesis family with losses and controls\n\n> **In plain terms.** A report on investment ideas can look better than it is when it shows only the ideas that worked. This check uses copied finance code to build made-up market claims, including winners, losers and a comparison case that should not count as a success. A validator rejects a set with only winners, and it flags a failed pattern promoted into the ideas to pursue and a comparison case relabeled as a confirmed claim. The output is a status with named findings, which shows whether the rules catch one-sided evidence.\n\nThis fixture builds a family of synthetic market theses using copied finance code and validates the resulting record. It includes winning and losing claims and a negative control, so the validator can check whether failed claims and controls remain visible in the sample.\n\nA survivor-only family is rejected with findings including `SURVIVORSHIP_SAMPLE`, `NO_LOSER_FLOWED_THROUGH`, and `NO_NEGATIVE_CONTROL`. Separate mutations promote a refuted pattern into forward candidates or mark a control as a confirmed claim; the validator reports `FORWARD_GATE_BREACH` or `CONTROL_LEAK`, respectively.\n\n## Run the example\n\nPython 3.11 or newer and the project test dependencies (install with `python3 -m pip install -e \".[test]\"`) are required. Run from the repository root:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.batch8_structural_theses_capsule run \\\n  --input fixtures/first_wave/batch8_structural_theses_capsule/input \\\n  --out .microcosm/component-guides/batch8_structural_theses_capsule \\\n  --acceptance-out .microcosm/component-guides/batch8_structural_theses_capsule/acceptance.json\n```\n\nThe command writes its result and acceptance files under `.microcosm/component-guides/`; inspect the status and findings in those files.\n\n## Verification\n\nTests of synthetic thesis records do not formally prove the finance algorithm or its predictions. Separately, `make component-replays` runs this component’s registered exported-bundle route through the [Dafny-proved replay admission check](../formal/replay/README.md). Using host-supplied observations, it compares source, input, claim-policy and receipt identities; it does not prove the component’s domain result. The direct command above does not invoke the shared check.\n\n## Limits\n\nRuns a synthetic thesis family through loss, control and forward-gate checks, rejecting a survivor-only sample, a promoted refuted pattern and a confirmed negative control.\n\n## Sources\n\n[src/microcosm_core/organs/batch8_structural_theses_capsule.py](../src/microcosm_core/organs/batch8_structural_theses_capsule.py) contains the implementation. See the [input fixtures](../fixtures/first_wave/batch8_structural_theses_capsule/input/), [tests](../tests/test_batch8_structural_theses_capsule.py), [historical sample acceptance result](../receipts/acceptance/first_wave/batch8_structural_theses_capsule_fixture_acceptance.json), and the [component JSON record](../core/paper_module_capsules.json). For background on survivorship bias, see [Brown, Goetzmann, Ibbotson and Ross](https://terpconnect.umd.edu/~wermers/ftpsite/FAME/Brown_Goetzmann_Ibbotson_Ross.pdf).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/batch8_structural_theses_capsule/exported_batch8_structural_theses_capsule_bundle_validation_result.json","guide_example":{"command":"microcosm batch8-structural-theses-capsule run --input fixtures/first_wave/batch8_structural_theses_capsule/input --out receipts/first_wave/batch8_structural_theses_capsule --acceptance-out receipts/acceptance/first_wave/batch8_structural_theses_capsule_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/batch8_structural_theses_ca