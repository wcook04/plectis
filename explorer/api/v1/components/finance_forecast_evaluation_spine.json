}},"claim_text_sha256":"c831c663074af95ac07bb442450d7726d9e9159811ec41e86e49d8a63aed483d","evidence":{"authority_availability":"available","authority_receipt_ref":"receipts/acceptance/first_wave/finance_forecast_evaluation_spine_fixture_acceptance.json","evidence_class":"external_subprocess_witness","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/finance_forecast_evaluation_spine/finance_forecast_evaluation_spine_result.json","receipts/first_wave/finance_forecast_evaluation_spine/finance_forecast_evaluation_spine_board.json","receipts/first_wave/finance_forecast_evaluation_spine/finance_forecast_evaluation_spine_validation_receipt.json","receipts/acceptance/first_wave/finance_forecast_evaluation_spine_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.finance_forecast_evaluation_spine","primary_guide_ref":"paper_modules/finance_forecast_evaluation_spine.md","registered_runner_ref":"src/microcosm_core/organs/finance_forecast_evaluation_spine.py","replay_id":"replay::finance_forecast_evaluation_spine","requirements_review":{"status":"unrecorded"},"summary":"Evaluate synthetic forecast-loss fixtures and boundary checks.","title":"Evaluate synthetic forecast losses"},"claim_ceiling":"tool witness only, not general proof authority","claim_ceiling_restated":"Runs the stationary bootstrap, reality check, superior predictive ability, model confidence set and Diebold–Mariano tests on 40 synthetic loss observations, and rejects a lookahead split. The exported bundle reports its declared statistics contract instead of recomputing the tests.","claim_id":"claim::finance_forecast_evaluation_spine","evidence_class":"external_subprocess_witness","evidence_strength_rank":4,"organ_id":"finance_forecast_evaluation_spine","truth_accounting_bucket":"real_runtime_receipt","validator_command":"python -m microcosm_core.organs.finance_forecast_evaluation_spine run --input fixtures/first_wave/finance_forecast_evaluation_spine/input --out receipts/first_wave/finance_forecast_evaluation_spine --acceptance-out receipts/acceptance/first_wave/finance_forecast_evaluation_spine_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"493938fca0289f7724ee64e973c33a96849df47b7f689b91fd6463acfd9c4365","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"external_subprocess_witness","family":"research_and_science_replays","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_runtime_receipt"},"component_id":"finance_forecast_evaluation_spine","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.finance_forecast_evaluation_spine","plain":"When forecasting methods are compared on a short record, the best one may have been lucky. This component reads made-up error scores for a baseline method and several candidate methods over 40 occasions, plus a policy on what results may claim. It runs standard statistical tests, several by re-drawing the scores at random 40 times, to judge whether differences between the methods are bigger than luck would explain. The output is each test's result, or a clear refusal when a setup lets a forecast see later data.","plain_availability":"available","ref":"paper_modules/finance_forecast_evaluation_spine.md","sha256":"30a2b81c698017797fb31df6dfc7e3107a6fc8aded3674ca26d32ccbdfe35fc0","text":"# Evaluate synthetic forecast losses\n\n> **In plain terms.** When forecasting methods are compared on a short record, the best one may have been lucky. This component reads made-up error scores for a baseline method and several candidate methods over 40 occasions, plus a policy on what results may claim. It runs standard statistical tests, several by re-drawing the scores at random 40 times, to judge whether differences between the methods are bigger than luck would explain. The output is each test's result, or a clear refusal when a setup lets a forecast see later data.\n\nThis component reads a matrix of synthetic losses for a baseline and candidate forecasts, paired loss series and a boundary policy. The fixture exercises stationary bootstrap, reality check, superior predictive ability and model confidence set calculations, as well as a Diebold–Mariano comparison. The test fixture has 40 observations. Its reality check, superior predictive ability and model confidence set calls each use 40 bootstrap replicates; a separate stationary-bootstrap index demonstration uses five. The fixture deliberately blocks SciPy imports to exercise a typed refusal of the Harvey–Leybourne–Newbold correction to the paired comparison, regardless of whether SciPy is installed.\n\nRuns the stationary bootstrap, reality check, superior predictive ability, model confidence set and Diebold–Mariano tests on 40 synthetic loss observations, and rejects a lookahead split. The exported bundle reports its declared statistics contract instead of recomputing the tests.\n\n## Run the example\n\nPython 3.11 or later is required. From the repository root, use the Python API to direct both result and acceptance output into ignored local state. The CLI does not expose the acceptance path for this action.\n\n```bash\nPYTHONPATH=src python3 - <<'PYCODE'\nfrom microcosm_core.organs.finance_forecast_evaluation_spine import run\nresult = run('fixtures/first_wave/finance_forecast_evaluation_spine/input', '.microcosm/component-guides/finance_forecast_evaluation_spine', acceptance_out='.microcosm/component-guides/finance_forecast_evaluation_spine/acceptance.json')\nprint(result['status'])\nPYCODE\n```\n\n## Verification\n\nThe fixture tests exercise the computations and refusals, not a proof of the statistical code. `make component-replays` runs the exported finance bundle through the [shared Dafny check](../formal/replay/README.md) over supplied source, input, claim-policy and receipt observations. The direct example does not invoke that gate.\n\n## Source\n\n[Implementation](../src/microcosm_core/organs/finance_forecast_evaluation_spine.py) · [Input](../fixtures/first_wave/finance_forecast_evaluation_spine/input) · [Tests](../tests/test_finance_forecast_evaluation_spine.py) · [Historical sample](../receipts/first_wave/finance_forecast_evaluation_spine/finance_forecast_evaluation_spine_result.json) · [JSON record](finance_forecast_evaluation_spine.json)\n\nFor background on forecast comparison, see [Diebold and Mariano](https://www.nber.org/papers/t0169) and [Hansen on superior predictive ability](https://ideas.repec.org/a/bes/jnlbes/v23y2005p365-380.html).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/finance_forecast_evaluation_spine/exported_finance_forecast_evaluation_spine_bundle_validation_result.json","guide_example":{"command":"microcosm finance-forecast-evaluation-spine run --input fixtures/first_wave/finance_forecast_evaluation_spine/input --out receipts/first_wave/finance_forecast_evaluation_spine","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/finance_forecast_evaluation_spine.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target