nknown"}},"claim_text_sha256":"af425ef4b2211c6f384a5801140a2cd05433b733ccb5251fef71c41c5f90ada6","evidence":{"authority_availability":"available","authority_receipt_ref":"receipts/acceptance/first_wave/formal_evidence_cell_anchor_resolver_fixture_acceptance.json","evidence_class":"algorithmic_projection","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/formal_evidence_cell_anchor_resolver/formal_evidence_cell_anchor_resolver_result.json","receipts/first_wave/formal_evidence_cell_anchor_resolver/evidence_cell_anchor_board.json","receipts/first_wave/formal_evidence_cell_anchor_resolver/formal_evidence_cell_anchor_resolver_validation_receipt.json","receipts/acceptance/first_wave/formal_evidence_cell_anchor_resolver_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.formal_evidence_cell_anchor_resolver","primary_guide_ref":"paper_modules/formal_evidence_cell_anchor_resolver.md","registered_runner_ref":"src/microcosm_core/organs/formal_evidence_cell_anchor_resolver.py","replay_id":"replay::formal_evidence_cell_anchor_resolver","requirements_review":{"status":"unrecorded"},"summary":"Resolve claims to public evidence cells and source markers.","title":"Resolve evidence cells to public source anchors"},"claim_ceiling":"projection mechanics only, not domain correctness","claim_ceiling_restated":"Checks that each paper claim names a known evidence cell and that its source paths, markers and imported module digests match, rejecting a missing anchor, a private source reference or human approval offered as proof evidence.","claim_id":"claim::formal_evidence_cell_anchor_resolver","evidence_class":"algorithmic_projection","evidence_strength_rank":3,"organ_id":"formal_evidence_cell_anchor_resolver","truth_accounting_bucket":"source_faithful_refactor","validator_command":"python -m microcosm_core.organs.formal_evidence_cell_anchor_resolver run --input fixtures/first_wave/formal_evidence_cell_anchor_resolver/input --out receipts/first_wave/formal_evidence_cell_anchor_resolver"},"claim_clause_coverage":{"claim_text_sha256":"59dcd28ace8ae81785d87e7b223731e8b19065e6ab3af2f8fd113e5477e6321c","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"algorithmic_projection","family":"formal_math_and_proof","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"source_faithful_refactor"},"component_id":"formal_evidence_cell_anchor_resolver","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.formal_evidence_cell_anchor_resolver","plain":"Each claim in a research paper should point to real evidence and to a findable place in public files. The resolver reads the paper's claims, evidence records and a list of named places in public source files. It checks that every claim names an evidence record that exists, that each file and marked spot it cites can be found, and that imported copies match their stored fingerprints. It saves a record of what resolved and rejects deliberately bad example claims, such as a missing cited place, a reference to private material and human approval treated as proof.","plain_availability":"available","ref":"paper_modules/formal_evidence_cell_anchor_resolver.md","sha256":"dcb1e97e15359760096b5558f995093864f584dc2c2c5a2362ac86052cf8820e","text":"# Resolve evidence cells to public source anchors\n\n> **In plain terms.** Each claim in a research paper should point to real evidence and to a findable place in public files. The resolver reads the paper's claims, evidence records and a list of named places in public source files. It checks that every claim names an evidence record that exists, that each file and marked spot it cites can be found, and that imported copies match their stored fingerprints. It saves a record of what resolved and rejects deliberately bad example claims, such as a missing cited place, a reference to private material and human approval treated as proof.\n\nThe resolver reads paper claims, evidence-cell records and public source anchors, then checks that claims name known cells and that referenced paths and markers resolve. Its result records the resolution without copying proof bodies into the receipt. The fixture includes deliberately invalid claims: a missing source anchor, a private source reference and a claim that human approval is proof evidence are rejected.\n\nChecks that each paper claim names a known evidence cell and that its source paths, markers and imported module digests match, rejecting a missing anchor, a private source reference or human approval offered as proof evidence.\n\n## Run the example\n\nPython 3.11 or later is required. From the repository root, write the fixture result and acceptance record to ignored local state.\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.formal_evidence_cell_anchor_resolver run --input fixtures/first_wave/formal_evidence_cell_anchor_resolver/input --out .microcosm/component-guides/formal_evidence_cell_anchor_resolver --acceptance-out .microcosm/component-guides/formal_evidence_cell_anchor_resolver/acceptance.json --card\n```\n\n## Verification\n\nTests exercise source-marker resolution, refusals and bundle digest checks; they do not prove the referenced claims. `make component-replays` runs the exported anchor bundle through the [shared Dafny check](../formal/replay/README.md) over supplied source, input, claim-policy and receipt observations. The direct example does not invoke that gate.\n\n## Source\n\n[Implementation](../src/microcosm_core/organs/formal_evidence_cell_anchor_resolver.py) · [Input](../fixtures/first_wave/formal_evidence_cell_anchor_resolver/input) · [Tests](../tests/test_formal_evidence_cell_anchor_resolver.py) · [Historical sample](../receipts/first_wave/formal_evidence_cell_anchor_resolver/formal_evidence_cell_anchor_resolver_result.json) · [JSON record](formal_evidence_cell_anchor_resolver.json)\n\n[W3C PROV](https://www.w3.org/TR/prov-overview/) describes a general provenance model; this resolver implements its own anchor checks.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/formal_evidence_cell_anchor_resolver/exported_evidence_cell_anchor_bundle_validation_result.json","guide_example":{"command":"microcosm formal-evidence-cell-anchor-resolver run-anchor-bundle --input examples/formal_evidence_cell_anchor_resolver/exported_evidence_cell_anchor_bundle --out receipts/runtime_shell/demo_project/organs/formal_evidence_cell_anchor_resolver","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/formal_evidence_cell_anchor_resolver.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[formal_evidence_cell_anchor_resolver].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"exported_evidence_cell_anchor_bundle","input_ref":"examples/formal_evidence_cell_anchor_resolver/exported_evidence_cell_anchor_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/formal_evidence_cell_anchor_resolver_fixture_acceptance.json","artifact_sha256":"9467e86bbd2777df19f0b1951cfcc88691608ae8b80042e73983450fec25b654","availability":"available","created_at":"2026-05-26T17:19:02+00:00","freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"formal_evidence_cell_anchor_resolver","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["plectis","component-replay","formal_evidence_cell_anchor_resolver"],"implementation_state":"companion_external_backend_proposal","input_override_supported":false,"kind":"fixed_component_replay_api","organ_id":"formal_evidence_cell_anchor_resolver","output_policy":"fresh ignored .microcosm/component-replays run under selected checkout","scope":"single_registered_component","worker_schema":"plectis_component_replay_worker_v1"},"receipt_name":"exported_evidence_cell_anchor_bundle_validation_result.json","replay_id":"replay::formal_evidence_cell_anchor_resolver","runner_ref":"src/microcosm_core/organs/formal_evidence_cell_anchor_resolver.py#run_anchor_bundle","span":"formal_evidence_cell_anchor_resolver.validate"},"requirements_reviews":{"records":[],"status":"unrecorded"},"subclaims":[]},"schema_version":"plectis_component_http_v1","snapshot_revision":"45be1deb333ad57cd9ae093229455d0a52d3bf23a9064cde09f1a6e16f4c7044"}