lable","created_at":null,"freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","replay_id":"replay::lean_proof_search_lab_runtime","status":"configured_not_run"},"requirements_review":{"status":"unrecorded"},"whole_claim":{"coverage_basis":"not_exhaustively_mapped","status":"unknown"}},"claim_text_sha256":"bdd85d5050ed975b49467fb9f7e1cb8ec320b4afd717271c38b26232132c45e8","evidence":{"authority_availability":"available","authority_receipt_ref":"receipts/acceptance/first_wave/lean_proof_search_lab_runtime_fixture_acceptance.json","evidence_class":"external_subprocess_witness","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/lean_proof_search_lab_runtime/lean_proof_search_lab_runtime_result.json","receipts/first_wave/lean_proof_search_lab_runtime/lean_proof_search_lab_runtime_board.json","receipts/first_wave/lean_proof_search_lab_runtime/lean_proof_search_lab_runtime_validation_receipt.json","receipts/acceptance/first_wave/lean_proof_search_lab_runtime_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.lean_proof_search_lab_runtime","primary_guide_ref":"paper_modules/lean_proof_search_lab_runtime.md","registered_runner_ref":"src/microcosm_core/organs/lean_proof_search_lab_runtime.py","replay_id":"replay::lean_proof_search_lab_runtime","requirements_review":{"status":"unrecorded"},"summary":"This lab runs bounded symbolic search on small Lean propositions and checks candidate proofs with Lean.","title":"Lean Proof Search Lab"},"claim_ceiling":"Runs a symbolic Lean proof-search lab over bounded public toy theorems with the installed Lean subprocess: an and/or candidate-tactic search, a forward oracle-leak firewall, a problem-id ablation, and a #print axioms cleanliness gate. It rejects forged or memorising scenarios by recomputation. Lean is an optional dependency: when the lean binary is absent the organ is locked and verifies nothing rather than faking a pass. It is not neural theorem proving, does not solve any open mathematical problem, does not forward oracle proof bodies, and does not authorize release or publication.","claim_ceiling_restated":"Searches small toy Lean propositions with a symbolic AND/OR procedure and checks candidate proofs with Lean, rejecting oracle fields, ID-memorising policies and `sorry`-tainted proofs; the exported bundle checks only file presence and counts.","claim_id":"claim::lean_proof_search_lab_runtime","evidence_class":"external_subprocess_witness","evidence_strength_rank":4,"organ_id":"lean_proof_search_lab_runtime","truth_accounting_bucket":"real_runtime_receipt","validator_command":"python -m microcosm_core.organs.lean_proof_search_lab_runtime run --input fixtures/first_wave/lean_proof_search_lab_runtime/input --out receipts/first_wave/lean_proof_search_lab_runtime --acceptance-out receipts/acceptance/first_wave/lean_proof_search_lab_runtime_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"b2c063d2fb18d4c7874dc79f8aec75f6a4889d5db1795e7284bd1cd92ca10f10","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"external_subprocess_witness","family":"formal_math_and_proof","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_runtime_receipt"},"component_id":"lean_proof_search_lab_runtime","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.lean_proof_search_lab_runtime","plain":"A proof-finding program can look good by cheating, so its proofs need checking. The lab is given two tiny logic statements, such as that two true statements are true together, and needs Lean, a program that checks proofs. It searches step by step, within limits, for a proof of each statement, has Lean check every candidate, and compares the result with a simpler method. The result is pass or fail, or 'locked' if Lean is missing, meaning nothing was checked, and cheats such as answer-key fields, proofs resting on placeholders or extra assumptions, and searches that memorize problem names are rejected. The packaged version instead checks that its three required files are present.","plain_availability":"available","ref":"paper_modules/lean_proof_search_lab_runtime.md","sha256":"45f5aaca207f21588fb8b8f43b02a0eb0a8f19fa75d968e44c5683ead3f0a07c","text":"# Lean Proof Search Lab\n\n> **In plain terms.** A proof-finding program can look good by cheating, so its proofs need checking. The lab is given two tiny logic statements, such as that two true statements are true together, and needs Lean, a program that checks proofs. It searches step by step, within limits, for a proof of each statement, has Lean check every candidate, and compares the result with a simpler method. The result is pass or fail, or 'locked' if Lean is missing, meaning nothing was checked, and cheats such as answer-key fields, proofs resting on placeholders or extra assumptions, and searches that memorize problem names are rejected. The packaged version instead checks that its three required files are present.\n\nThis lab runs bounded symbolic search on small Lean propositions and checks candidate proofs with Lean. The positive fixture includes `theorem lab_and_intro (p q : Prop) : p -> q -> And p q` and `theorem lab_or_comm (p q : Prop) : Or p q -> Or q p`. Search uses a bounded AND/OR procedure and compares it with a hammer-style baseline; an ID-blind policy ablation checks for dependence on problem identifiers.\n\nThe negative cases include oracle fields, `sorry`/axiom taint, and a policy that memorizes problem IDs. The fixture run requires a `lean` executable on PATH. If Lean is absent, it reports `locked` with no verification performed, rather than a pass or failure. The separate exported-bundle runner checks that three required files exist and counts JSON files. It neither executes Lean nor verifies the retained proof material, so its pass is not a fresh proof check. These examples do not establish results for open problems or neural theorem proving.\n\n## Run the example\n\nFrom the repository root with Python 3.11 or newer, run the supplied fixture into ignored local output:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.lean_proof_search_lab_runtime run \\\n  --input fixtures/first_wave/lean_proof_search_lab_runtime/input \\\n  --out .microcosm/component-guides/lean_proof_search_lab_runtime/out \\\n  --acceptance-out .microcosm/component-guides/lean_proof_search_lab_runtime/acceptance.json\n```\n\nInspect the reported status as well as the process exit code: `locked` exits successfully but means Lean did not run.\n\n## Verification\n\nThe direct fixture needs Lean on `PATH` to check candidate proofs of `lab_and_intro` and `lab_or_comm`; without it the run is `locked`. `make component-replays` instead runs the exported file-presence check under the [shared Dafny admission check](../formal/replay/README.md). Neither admission nor file presence proves the search algorithm correct.\n\n## Source and evidence\n\n- [Implementation](../src/microcosm_core/organs/lean_proof_search_lab_runtime.py) and [fixture inputs](../fixtures/first_wave/lean_proof_search_lab_runtime/input/).\n- [Tests](../tests/test_lean_proof_search_lab_runtime.py).\n- [Saved example result](../receipts/first_wave/lean_proof_search_lab_runtime/lean_proof_search_lab_runtime_result.json) (historical, not a fresh run).\n- [Component JSON record](./lean_proof_search_lab_runtime.json) and [canonical capsule](../core/paper_module_capsules.json).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs","src/microcosm_core/component_replay.py#native_replay_step"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"declared_route":{"example_rel":"examples/lean_proof_search_lab_runtime/exported_lean_proof_search_lab_runtime_bundle","input_mode":"exported_lean_proof_search_lab_runtime_bundle","receipt_name":"lean_proof_search_lab_runtime_result.json","runner_ref":"src/microcosm_core/organs/lean_proof_search_lab_runtime.py#run_lean_proof_search_lab_runtime_bundle"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/lean_proof_search_lab_runtime/lean_proof_search_lab_runtime_result.json","guide_example":{"command":"microcosm lean-proof-search-lab-runtime run --input fixtures/first_wave/lean_proof_search_lab_runtime/input --out receipts/first_wave/lean_proof_search_lab_runtime --acceptance-out receipts/acceptance/first_wave/lean_proof_search_lab_runtime_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/lean_proof_search_lab_runtime.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[lean_proof_search_lab_runtime].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"lean_proof_search_lab_fixture_cases","input_ref":"fixtures/fi