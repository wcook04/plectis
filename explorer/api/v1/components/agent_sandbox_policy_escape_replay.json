ity":"available","authority_receipt_ref":"receipts/acceptance/first_wave/agent_sandbox_policy_escape_replay_fixture_acceptance.json","evidence_class":"algorithmic_projection","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/agent_sandbox_policy_escape_replay/agent_sandbox_policy_escape_replay_result.json","receipts/first_wave/agent_sandbox_policy_escape_replay/agent_sandbox_policy_escape_replay_board.json","receipts/first_wave/agent_sandbox_policy_escape_replay/agent_sandbox_policy_escape_replay_validation_receipt.json","receipts/acceptance/first_wave/agent_sandbox_policy_escape_replay_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":["subclaim::sandbox_policy"],"primary_guide_id":"paper_module.agent_sandbox_policy_escape_replay","primary_guide_ref":"paper_modules/agent_sandbox_policy_escape_replay.md","registered_runner_ref":"src/microcosm_core/organs/agent_sandbox_policy_escape_replay.py","replay_id":"replay::agent_sandbox_policy_escape_replay","requirements_review":{"status":"unrecorded"},"summary":"Derives policy decisions for synthetic action records and checks their side-effect receipts.","title":"Replay sandbox policy decisions"},"claim_ceiling":"projection mechanics only, not domain correctness","claim_ceiling_restated":"Derives a verdict for each synthetic action request from a fixed table of action kind, capability, risk and source trust, blocks unknown shapes, and checks that blocked actions left no diff and permitted ones have diff and rollback records.","claim_id":"claim::agent_sandbox_policy_escape_replay","evidence_class":"algorithmic_projection","evidence_strength_rank":3,"organ_id":"agent_sandbox_policy_escape_replay","truth_accounting_bucket":"source_faithful_refactor","validator_command":"python -m microcosm_core.organs.agent_sandbox_policy_escape_replay run --input fixtures/first_wave/agent_sandbox_policy_escape_replay/input --out receipts/first_wave/agent_sandbox_policy_escape_replay --acceptance-out receipts/acceptance/first_wave/agent_sandbox_policy_escape_replay_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"59dcd28ace8ae81785d87e7b223731e8b19065e6ab3af2f8fd113e5477e6321c","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"algorithmic_projection","family":"agent_reliability_and_safety","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"source_faithful_refactor"},"component_id":"agent_sandbox_policy_escape_replay","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.agent_sandbox_policy_escape_replay","plain":"A sandbox is a restricted area where an automated assistant's actions are held to rules. This component is given made-up action requests, each with its kind, risk level and source trust, plus the written decision and recorded changes. It looks up the decision in a fixed table, blocks unfamiliar requests, and checks that blocked actions never ran and allowed ones have change and undo records. It lists each decision and any mismatch, such as an allow label on a request the table blocks. The table lookup is checked by a mathematical proof against written rules.","plain_availability":"available","ref":"paper_modules/agent_sandbox_policy_escape_replay.md","sha256":"dcd1285376e1236c4b79995455d675ec437942942c7f1f38fc83ac8c5582239d","text":"# Replay sandbox policy decisions\n\n> **In plain terms.** A sandbox is a restricted area where an automated assistant's actions are held to rules. This component is given made-up action requests, each with its kind, risk level and source trust, plus the written decision and recorded changes. It looks up the decision in a fixed table, blocks unfamiliar requests, and checks that blocked actions never ran and allowed ones have change and undo records. It lists each decision and any mismatch, such as an allow label on a request the table blocks. The table lookup is checked by a mathematical proof against written rules.\n\nThis replay checks synthetic action requests, policy decisions and recorded side effects. A fixed table derives a verdict from the action kind, capability, risk and source trust; the validator compares that verdict with the declared one. Unknown action shapes fail closed to `block`. It checks that blocked actions were not executed and had no recorded diff, and that permitted effects have the required diff and rollback records.\n\nFor example, an `allow` label on a request that the table derives as blocked is rejected. These symbolic records exercise the accounting rules; they do not run a real escape attempt or demonstrate host containment, network isolation or resistance to attack.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer and the repository dependencies available:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.agent_sandbox_policy_escape_replay \\\n  run --input fixtures/first_wave/agent_sandbox_policy_escape_replay/input \\\n  --out .microcosm/component-guides/agent_sandbox_policy_escape_replay/output \\\n  --acceptance-out .microcosm/component-guides/agent_sandbox_policy_escape_replay/acceptance.json\n```\n\nThe result records policy decisions, side-effect checks and any findings. It is written under `.microcosm/component-guides/agent_sandbox_policy_escape_replay/output`; the acceptance receipt is separate. These paths do not overwrite the checked-in receipts.\n\n## Verification\n\nThe replay calls the [proved sandbox decision core](../formal/components/sandbox_policy/README.md) for each normalized action. Its proof covers the six recognized risk, action, capability and trust combinations, their exact verdict and rule strings, and the fail-closed result for all other combinations. Python supplies the observed fields; the proof does not establish their authenticity or enforce host isolation.\n\nThe example uses that core. `make component-replays` separately applies the shared [replay admission check](../formal/replay/README.md) to the exported bundle.\n\n## Source\n\n[Implementation](../src/microcosm_core/organs/agent_sandbox_policy_escape_replay.py) · [fixture input](../fixtures/first_wave/agent_sandbox_policy_escape_replay/input/) · [tests](../tests/test_agent_sandbox_policy_escape_replay.py) · [sample result (historical)](../receipts/first_wave/agent_sandbox_policy_escape_replay/agent_sandbox_policy_escape_replay_result.json) · [JSON record](agent_sandbox_policy_escape_replay.json).\n\nThe [least privilege and complete mediation principles](https://www.cs.virginia.edu/~evans/cs551/saltzer/) provide useful background.\n"},"proofs":[{"claim_ids":["claim::agent_sandbox_policy_escape_replay"],"component_ids":["agent_sandbox_policy_escape_replay"],"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"guide":{"availability":"available","plain":null,"plain_availability":"unrecorded","ref":"formal/components/sandbox_policy/README.md","sha256":"25e191314ce78e73c6915f36f295c6f8968b66d6b09fad02b3f28a3287f446bf","text":"# Sandbox policy decision\n\n`SandboxPolicy.dfy` specifies and implements the sandbox replay's decision over\nfour normalized action fields. `DecisionExact` proves that each of the six\nrecognized risk/action/capability/trust tuples receives its specified rule and\nthat every other tuple receives the fail-closed code. `FullOutputExact` relates\nthat decision to the exact public verdict and rule strings. In particular,\nonly the public-fixture write tuple is allowed, and only the mock-database tuple\nreceives review. The trust-guard mutant removes a required trust check; the\nproof and the concrete untrusted-input assertion reject it.\n\nThe generated `Evaluate` function is called by\n`agent_sandbox_policy_escape_replay._derived_sandbox_policy_verdict` through the\nshared isolated component worker. The trusted Python adapter applies the\nexisting `str(value or \"\")` normalization. It represents any normalized field\nlonger than 128 characters by an empty field before invocation: none of the\npolicy literals is that long, so either value fails the same equality checks.\nThe original row is retained for reporting. Adapter behavior, the worker,\nDafny, its compiler, Python and the host remain trusted.\n\nThis proves the replay's decision table over the supplied fields. It does not\nprove that those fields describe a real action, that the policy is adequate,\nor that a host sandbox prevents execution or side effects. Existing fixture\nand subprocess tests exercise the integration separately.\n\nTo recheck the theorem and generated bytes with the pinned Dafny release, use\n`python3 scripts/check/check_component_kernels.py --dafny /path/to/dafny`.\nThe normal hash-binding check does not rerun Dafny.\n"},"index_state":"retained_generated_snapshot","modeled_contracts":[{"assumptions":"Trusted host supplies normalized observations; adapter, isolated worker, Dafny, compiler and runtime remain trusted.","contract_sha256":"b5f20c553cbd7ad13f973cd1012bcb4b3f13c2526da1afbf52731d87d09d3e53","descriptor_origin":"metadata_contract","entry_theorem_refs":["formal/components/sandbox_policy/SandboxPolicy.dfy#DecisionExact","formal/components/sandbox_policy/SandboxPolicy.dfy#FullOutputExact","formal/components/sandbox_policy/SandboxPolicy.dfy#UntrustedFixtureFailsClosed"],"input_model":"Four normalized risk, action, capability and source-trust strings.","limits":"Host normalization is trusted; the proof does not establish real sandbox containment or the authenticity of action records.","requirements_review":{"status":"unrecorded"},"specification_refs":["formal/components/sandbox_policy/SandboxPolicy.dfy#PolicySpec","formal/components/sandbox_policy/SandboxPolicy.dfy#OutputSpec"],"statement":"Six recognized action shapes receive their exact verdict and rule; all other normalized shapes fail closed.","subclaim_id":"subclaim::sandbox_policy"}],"proof":{"adapter_ref":"src/plectis/components/sandbox_policy/_adapter.py","claim_ids":["claim::agent_sandbox_policy_escape_replay"],"component_ids":["agent_sandbox_policy_escape_replay"],"current_binding":{"assessment_time_basis":"index_generation_only","checker_ref":"scripts/check/check_component_kernels.py#check_binding","generated_python":{"SandboxPolicy.py":"ac2e887c3ae080fa85275f1ad5e6d82d652930c1cc8044f3d4c457b5afb02153","System_/__init__.py":"96b6e33c036bc3aeab6d1810c7aef085184d09c407bdec032ea89d7a98843edf","__main__.py":"f60b39f0e536210e7081a9bf1c7d01aec97abac0a7ebca5b44afc0d90e721ef0","_dafny/__init__.py":"18d39decdedad0e188456e15d17f1dcd5113c4abc258ad6cb718e39534555e7a","module_.py":"18e4b15694fa750c81aa2e8fabf22b5248e4734d111a34700c479d85f653cd54"},"source_sha256":"17dd2c94f6b511ea63edb8a86b75c7dedc2cc981b67e141813d36baf21fe3892","status":"current_hash_binding_pass"},"entry_theorem_refs":["formal/components/sandbox_policy/SandboxPolicy.dfy#DecisionExact","formal/components/sandbox_policy/SandboxPolicy.dfy#FullOutputExact","formal/components/sandbox_policy/SandboxPolicy.dfy#UntrustedFixtureFailsClosed"],"excerpts":[{"kind":"predicate","line_end":23,"line_start":15,"name":"PolicySpec","ref":"formal/components/sandbox_policy/SandboxPolicy.dfy#PolicySpec","source_sha256":"17dd2c94f6b511ea63edb8a86b75c7dedc2cc981b67e141813d36baf21fe3892","text":"  predicate PolicySpec(r: string, a: string, c: string, t: string, code: int) {\n    (code == 1 <==> r == \"secret_access\" && a == \"environment_secret_read\" && c == \"environment_read\" && t == \"untrusted_tool_output\") &&\n    (code == 2 <==> r == \"network_exfiltration\" && a == \"network_request\" && c == \"outbound_network\" && t == \"untrusted_tool_output\") &&\n    (code == 3 <==> r == \"destructive_filesystem_mutation\" && a == \"filesystem_delete\" && c == \"filesystem_write\" && t == \"untrusted_repo_file\") &&\n    (code == 4 <==> r == \"escape_payload_obfuscation\" && a == \"shell_command\" && c == \"shell_exec\" && t == \"untrusted_tool_output\") &&\n    (code == 5 <==> AuthorizedWrite(r,a,c,t)) &&\n    (code == 6 <==> ReviewedWrite(r,a,c,t)) &&\n    0 <= code <= 6\n  }\n","text_sha256":"540163534887cc25c58ebcfea8082ae26beee7fe3c0e500199b3ffb6d399991b"},{"kind":"predicate","line_end":75,"line_start":66,"name":"OutputSpec","ref":"formal/components/sandbox_policy/SandboxPolicy.dfy#OutputSpec","source_sha256":"17dd2c94f6b511ea63edb8a86b75c7dedc2cc981b67e141813d36baf21fe3892","text":"  ghost predicate OutputSpec(r: string, a: string, c: string, t: string, v: string, rule: string) {\n    exists code: int :: PolicySpec(r,a,c,t,code) && (\n      (code == 0 && v == \"block\" && rule == \"rule:sandbox_policy_fail_closed_unrecognized_action\") ||\n      (code == 1 && v == \"block\" && rule == \"rule:no_secret_or_env_read_from_untrusted_context\") ||\n      (code == 2 && v == \"block\" && rule == \"rule:no_live_network_from_untrusted_context\") ||\n      (code == 3 && v == \"block\" && rule == \"rule:no_destructive_filesystem_mutation\") ||\n      (code == 4 && v == \"block\" && rule == \"rule:no_executable_escape_payload_or_obfuscation\") ||\n      (code == 5 && v == \"allow\" && rule == \"rule:public_fixture_write_with_diff_receipt\") ||\n      (code == 6 && v == \"review\" && rule == \"rule:side_effect_requires_approval_and_rollback\"))\n  }\n","text_sha256":"fccaaddd779cacee85e84ee988afdf5acd6f35d51ade1104255e731d6a2fd6b2"},{"kind":"lemma","line_end":40,"line_start":35,"name":"DecisionExact","ref":"formal/components/sandbox_policy/SandboxPolicy.dfy#DecisionExact","source_sha256":"17dd2c94f6b511ea63edb8a86b75c7dedc2cc981b67e141813d36baf21fe3892","text":"  lemma DecisionExact(r: string, a: string, c: string, t: string)\n    ensures PolicySpec(r,a,c,t,Decide(r,a,c,t))\n    ensures (Decide(r,a,c,t) == 5) <==> AuthorizedWrite(r,a,c,t)\n    ensures (Decide(r,a,c,t) == 6) <==> ReviewedWrite(r,a,c,t)\n    ensures !AuthorizedWrite(r,a,c,t) && !ReviewedWrite(r,a,c,t) ==> Decide(r,a,c,t) <= 4\n  {}\n","text_sha256":"c5ec77c0c3adc44ebd7b3f9417d1833ed655ed455bfb16e5bc3499095cd9ae9d"},{"kind":"lemma","line_end":78,"line_start":76,"name":"FullOutputExact","ref":"formal/components/sandbox_policy/SandboxPolicy.dfy#FullOutputExact","source_sha256":"17dd2c94f6b511ea63edb8a86b75c7dedc2cc981b67e141813d36baf21fe3892","text":"  lemma FullOutputExact(r: string, a: string, c: string, t: string)\n    ensures OutputSpec(r,a,c,t,Evaluate(r,a,c,t).0,Evaluate(r,a,c,t).1)\n  { DecisionExact(r,a,c,t); }\n","text_sha256":"5d3613c5ed7017674fd573ce9a3e11e17dad2e1be13072727c8621adb5b57f28"},{"kind":"lemma","line_end":44,"line_start":42,"name":"UntrustedFixtureFailsClosed","ref":"formal/components/sandbox_policy/SandboxPolicy.dfy#UntrustedFixtureFailsClosed","source_sha256":"17dd2c94f6b511ea63edb8a86b75c7dedc2cc981b67e141813d36baf21fe3892","text":"  lemma UntrustedFixtureFailsClosed()\n    ensures Decide(\"low_risk_public_fixture_mutation\", \"filesystem_write\", \"public_fixture_write\", \"untrusted_tool_output\") == 0\n  {}\n","text_sha256":"5a3af0ba253f775f7c0ef632837a53bc7f49f9074fedaf59f993a6487b68a684"}],"fresh_prover_result":{"status":"not_run_by_index"},"generated_refs":["src/plectis/components/sandbox_policy/_generated/SandboxPolicy.py","src/plectis/components/sandbox_policy/_generated/System_/__init__.py","src/plectis/components/sandbox_policy/_generated/__main__.py","src/plectis/components/sandbox_policy/_generated/_dafny/__init__.py","src/plectis/components/sandbox_policy/_generated/module_.py"],"guide":{"availability":"available","plain":null,"plain_availability":"unrecorded","ref":"formal/components/sandbox_policy/README.md","sha256":"25e191314ce78e73c6915f36f295c6f8968b66d6b09fad02b3f28a3287f446bf","text":"# Sandbox policy decision\n