ped","status":"unknown"}},"claim_text_sha256":"ef5eaa635dd40476465044ba7f1bcc9c0af089e481742925d0c12eb1d598f5cd","evidence":{"authority_availability":"available","authority_receipt_ref":"receipts/acceptance/first_wave/belief_state_process_reward_replay_fixture_acceptance.json","evidence_class":"algorithmic_projection","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/belief_state_process_reward_replay/belief_state_process_reward_replay_result.json","receipts/first_wave/belief_state_process_reward_replay/belief_state_process_reward_replay_board.json","receipts/first_wave/belief_state_process_reward_replay/belief_state_process_reward_replay_validation_receipt.json","receipts/acceptance/first_wave/belief_state_process_reward_replay_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.belief_state_process_reward_replay","primary_guide_ref":"paper_modules/belief_state_process_reward_replay.md","registered_runner_ref":"src/microcosm_core/organs/belief_state_process_reward_replay.py","replay_id":"replay::belief_state_process_reward_replay","requirements_review":{"status":"unrecorded"},"summary":"Replay checks links and policy constraints in synthetic process-reward records.","title":"Replay a process-reward record with verifier feedback"},"claim_ceiling":"projection mechanics only, not domain correctness","claim_ceiling_restated":"Checks the links between synthetic episodes, belief states, verifier feedback, rewards and trajectory groups, and rejects a verifier bypass or reward hacking.","claim_id":"claim::belief_state_process_reward_replay","evidence_class":"algorithmic_projection","evidence_strength_rank":3,"organ_id":"belief_state_process_reward_replay","truth_accounting_bucket":"source_faithful_refactor","validator_command":"python -m microcosm_core.organs.belief_state_process_reward_replay run --input fixtures/first_wave/belief_state_process_reward_replay/input --out receipts/first_wave/belief_state_process_reward_replay"},"claim_clause_coverage":{"claim_text_sha256":"59dcd28ace8ae81785d87e7b223731e8b19065e6ab3af2f8fd113e5477e6321c","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"algorithmic_projection","family":"agent_reliability_and_safety","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"source_faithful_refactor"},"component_id":"belief_state_process_reward_replay","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.belief_state_process_reward_replay","plain":"When a program is trained with scores for each step and for its final result, careless scoring can reward the wrong things. This component is given made-up records of task attempts, covering the program's beliefs, the feedback it received, the scores awarded and a stored re-run. It follows each link between these records and checks them against a written rule, under which every step score must rest on an automatic checker or observed feedback. It reports a pass or a block with findings, for example rejecting a bypassed checker or a score for neat formatting.","plain_availability":"available","ref":"paper_modules/belief_state_process_reward_replay.md","sha256":"1e5d5b2f2882d18bd3d07a6bbbc8b3eec65aed64c3cfeebe262c252ab48d5449","text":"# Replay a process-reward record with verifier feedback\n\n> **In plain terms.** When a program is trained with scores for each step and for its final result, careless scoring can reward the wrong things. This component is given made-up records of task attempts, covering the program's beliefs, the feedback it received, the scores awarded and a stored re-run. It follows each link between these records and checks them against a written rule, under which every step score must rest on an automatic checker or observed feedback. It reports a pass or a block with findings, for example rejecting a bypassed checker or a score for neat formatting.\n\nThis replay checks synthetic records of task episodes, belief states, feedback and rewards. Process rewards refer to intermediate steps; outcome rewards refer to the final result. A trajectory group links those rewards with an episode and a stored cold-replay record, which names replay evidence and records a status.\n\nFor example, the terminal-investigation fixture links its first belief state and process reward to `fb_terminal_1`, a deterministic-verifier feedback record. Its trajectory group also names a second process reward and an outcome reward. The validator checks these references and their relationships. Its policy permits process rewards based on deterministic verification or observed environment feedback, and requires a cold-replay record, an outcome reward and a reward-hacking trap.\n\nNegative cases include a verifier bypass, hidden reasoning export, a neural-judge-only process label and a reward based on formatting. A mutated feedback link or a numeric perturbation can block semantic recomputation in the tests.\n\n## Run the example\n\nPython 3.11 or newer and the project test dependencies (install with `python3 -m pip install -e \".[test]\"`) are required. Run from the repository root:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.belief_state_process_reward_replay run \\\n  --input fixtures/first_wave/belief_state_process_reward_replay/input \\\n  --out .microcosm/component-guides/belief_state_process_reward_replay \\\n  --acceptance-out .microcosm/component-guides/belief_state_process_reward_replay/acceptance.json\n```\n\nThe command writes its result and acceptance files under `.microcosm/component-guides/`; inspect the status and findings in those files.\n\n## Verification\n\nChecks on the synthetic records do not formally prove the reward policy or model performance. Separately, `make component-replays` runs this component’s registered exported-bundle route through the [Dafny-proved replay admission check](../formal/replay/README.md). Using host-supplied observations, it compares source, input, claim-policy and receipt identities; it does not prove the component’s domain result. The direct command above does not invoke the shared check.\n\n## Limits\n\nChecks the links between synthetic episodes, belief states, verifier feedback, rewards and trajectory groups, and rejects a verifier bypass or reward hacking.\n\n## Sources\n\n[src/microcosm_core/organs/belief_state_process_reward_replay.py](../src/microcosm_core/organs/belief_state_process_reward_replay.py) contains the implementation. See the [input fixtures](../fixtures/first_wave/belief_state_process_reward_replay/input/), [tests](../tests/test_belief_state_process_reward_replay.py), [historical sample acceptance result](../receipts/acceptance/first_wave/belief_state_process_reward_replay_fixture_acceptance.json), and the [component JSON record](../core/paper_module_capsules.json). Background: [process supervision research](https://arxiv.org/abs/2305.20050).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/belief_state_process_reward_replay/exported_belief_state_process_reward_bundle_validation_result.json","guide_example":{"command":"PYTHONPATH=src python3 -m microcosm_core.organs.belief_state_process_reward_replay run --input fixtures/first_wave/belief_state_process_reward_replay/input --out .microcosm/belief_state_process_reward_replay","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/belief_state_process_reward_replay.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[belief_state_process_reward_replay].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":false},"input_mode":"exported_belief_state_process_reward_bundle","input_ref":"examples/belief_state_process_reward_replay/exported_belief_state_process_reward_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/belief_state_process_reward_replay_fixture_acceptance.json","artifact_sha256":"8d407463a34e18419bebcdcc65459aad4651408cd229b6a9a40f982e453dddfc","availability":"available","created_at":"2026-05-27T03:11:08+00:00","freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"belief_state_process_reward_replay","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["plectis","component-replay","belief_state_process_reward_replay"],"implementation_state":"companion_external_backend_proposal","input_override_supported":false,"kind":"fixed_component_replay_api","organ_id":"belief_state_process_reward_replay","output_policy":"fresh ignored .microcosm/component-replays run under selected checkout","scope":"single_registered_component","worker_