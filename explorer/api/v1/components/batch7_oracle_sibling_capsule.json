ve/batch7_oracle_sibling_capsule_fixture_acceptance.json","evidence_class":"verified_macro_body_import","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/batch7_oracle_sibling_capsule/batch7_oracle_sibling_capsule_result.json","receipts/first_wave/batch7_oracle_sibling_capsule/batch7_oracle_sibling_capsule_board.json","receipts/first_wave/batch7_oracle_sibling_capsule/batch7_oracle_sibling_capsule_validation_receipt.json","receipts/acceptance/first_wave/batch7_oracle_sibling_capsule_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.batch7_oracle_sibling_capsule","primary_guide_ref":"paper_modules/batch7_oracle_sibling_capsule.md","registered_runner_ref":"src/microcosm_core/organs/batch7_oracle_sibling_capsule.py","replay_id":"replay::batch7_oracle_sibling_capsule","requirements_review":{"status":"unrecorded"},"summary":"Exercises copied Oracle modules for artifact indexing, snapshots and comparisons.","title":"Exercise Oracle indexing and repair planning"},"claim_ceiling":"verified non-secret macro body import only, not Oracle reasoning, provider or bridge authority, source mutation, semantic truth, complete coverage, release, or publication","claim_ceiling_restated":"Runs copied Oracle modules to index a sample run's artifacts, build a snapshot and compare a macroeconomic series, rejecting an artifact without an identity; the original pytest test needs pytest and its source dependencies.","claim_id":"claim::batch7_oracle_sibling_capsule","evidence_class":"verified_macro_body_import","evidence_strength_rank":5,"organ_id":"batch7_oracle_sibling_capsule","truth_accounting_bucket":"copied_non_secret_macro_body","validator_command":"python -m microcosm_core.organs.batch7_oracle_sibling_capsule run --input fixtures/first_wave/batch7_oracle_sibling_capsule/input --out receipts/first_wave/batch7_oracle_sibling_capsule --acceptance-out receipts/acceptance/first_wave/batch7_oracle_sibling_capsule_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"a4b37138177d8957d790a1082a4b6c0e7d3cf38ad47679c66a8b73ba3be0e186","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"verified_macro_body_import","family":"import_projection_and_drift","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"copied_non_secret_macro_body"},"component_id":"batch7_oracle_sibling_capsule","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.batch7_oracle_sibling_capsule","plain":"A system that produces many output files needs a way to list them and fill gaps. It is given copied code from Oracle, a market-evidence system, and the output files of a small sample run. It lists those files, builds a snapshot, compares an economic data series and tests a plan for filling in files missing from a related run. The plan stays blocked because some inputs it needs are missing, and the output is a set of short summaries of how the copied code behaves on the sample.","plain_availability":"available","ref":"paper_modules/batch7_oracle_sibling_capsule.md","sha256":"707bfbf55d0c6e22618bc1bc72834091dc9a5d2abc5731e8994585c0e0b21fbd","text":"# Exercise Oracle indexing and repair planning\n\n> **In plain terms.** A system that produces many output files needs a way to list them and fill gaps. It is given copied code from Oracle, a market-evidence system, and the output files of a small sample run. It lists those files, builds a snapshot, compares an economic data series and tests a plan for filling in files missing from a related run. The plan stays blocked because some inputs it needs are missing, and the output is a set of short summaries of how the copied code behaves on the sample.\n\nThis fixture loads copied modules from Oracle, a market-evidence system, to index artifacts from a sample subject run, build a snapshot and compare a macroeconomic series. It also tests a plan for filling missing artifacts in a related truth run and runs an original pytest witness. It writes summaries of these local exercises.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer and the project dependencies installed:\n\n```sh\nPYTHONPATH=src python3 -m microcosm_core.organs.batch7_oracle_sibling_capsule run \\\n  --input fixtures/first_wave/batch7_oracle_sibling_capsule/input \\\n  --out .microcosm/component-guides/batch7_oracle_sibling_capsule/result \\\n  --acceptance-out .microcosm/component-guides/batch7_oracle_sibling_capsule/acceptance.json --card\n```\n\nThe command prints a compact JSON card and writes its results under `.microcosm/component-guides/`. A passing run returns exit code 0; a blocked run returns 1.\n\n## What this checks\n\nThe subject index requires a run directory and artifact identity. In the repair example, the plan remains blocked because source nodes are missing, but writes a `prediction_reconciliation` alias of the existing `oracle_truth_diff_equity` artifact. It excludes the missing-quartet execution path and does not construct the bridge-backed reasoning engine. Missing artifact identity is a rejected case.\n\n## Verification\n\nThe example above runs the fixture directly. In `make component-replays`, this component’s exported bundle is checked by the [shared Dafny replay admission core](../formal/replay/README.md) for agreement among supplied source, input, claim-policy and receipt observations. That admission check does not prove this component’s algorithm or the truth of its domain claims.\n\n## Limits\n\nRuns copied Oracle modules to index a sample run's artifacts, build a snapshot and compare a macroeconomic series, rejecting an artifact without an identity; the original pytest test needs pytest and its source dependencies.\n\n## Source and evidence\n\nRead the [implementation](../src/microcosm_core/organs/batch7_oracle_sibling_capsule.py), [fixture input](../fixtures/first_wave/batch7_oracle_sibling_capsule/input/batch7_oracle_sibling_exercise_manifest.json), and [focused tests](../tests/test_batch7_oracle_sibling_capsule.py). The [saved acceptance result](../receipts/acceptance/first_wave/batch7_oracle_sibling_capsule_fixture_acceptance.json) is historical sample evidence, not the result of your run. The [JSON record](batch7_oracle_sibling_capsule.json) identifies the module; the canonical capsule metadata is in [paper_module_capsules.json](../core/paper_module_capsules.json).\n\nThe [test oracle problem survey](https://discovery.ucl.ac.uk/1471263/) provides background on the distinction between outputs and evidence of correctness.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/batch7_oracle_sibling_capsule/exported_batch7_oracle_sibling_capsule_validation_result.json","guide_example":{"command":"PYTHONPATH=src python3 -m microcosm_core.organs.batch7_oracle_sibling_capsule run --input fixtures/first_wave/batch7_oracle_sibling_capsule/input --out receipts/first_wave/batch7_oracle_sibling_capsule --acceptance-out receipts/acceptance/first_wave/batch7_oracle_sibling_capsule_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/batch7_