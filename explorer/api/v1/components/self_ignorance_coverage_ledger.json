acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"59dcd28ace8ae81785d87e7b223731e8b19065e6ab3af2f8fd113e5477e6321c","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"algorithmic_projection","family":"architecture_and_navigation","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"source_faithful_refactor"},"component_id":"self_ignorance_coverage_ledger","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.self_ignorance_coverage_ledger","plain":"A project keeps a map of its own parts, and some parts it knows exist may be missing from the map. This comparison reads counts and identifiers for categories such as concepts and standards, plus a saved map that represents some of them. For each category it works out the shortfall between the listed count and the number shown on the map, and checks that required identifiers are present. The shortfall, called coverage debt, points to known gaps, and a claim that a missing entry shows something does not exist is rejected.","plain_availability":"available","ref":"paper_modules/self_ignorance_coverage_ledger.md","sha256":"eecebc691011ac9a149cc89b6346d40c4b5746d72328975ace3531405594204e","text":"# Compare known atlas coverage\n\n> **In plain terms.** A project keeps a map of its own parts, and some parts it knows exist may be missing from the map. This comparison reads counts and identifiers for categories such as concepts and standards, plus a saved map that represents some of them. For each category it works out the shortfall between the listed count and the number shown on the map, and checks that required identifiers are present. The shortfall, called coverage debt, points to known gaps, and a claim that a missing entry shows something does not exist is rejected.\n\nThe exported bundle contains counts and IDs for categories such as concepts and standards, plus a saved system graph representing some of those entities. This component compares the two: for each category it reports the shortfall between the listed count and the number represented in the graph, and checks required IDs. The resulting coverage debt helps locate known gaps in that graph.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer and the checkout dependencies available:\n\n```sh\nPYTHONPATH=src python3 -m microcosm_core.organs.self_ignorance_coverage_ledger run-self-ignorance-bundle \\\n  --input examples/self_ignorance_coverage_ledger/exported_self_ignorance_coverage_ledger_bundle \\\n  --out .microcosm/component-guides/self_ignorance_coverage_ledger\n```\n\nInspect `.microcosm/component-guides/self_ignorance_coverage_ledger/exported_self_ignorance_coverage_ledger_bundle_validation_result.json` for the result and findings.\n\nThe graph is a snapshot: the reported debt is relative to the selected kind rows and materialized entities in that bundle. Inspect the board to see which kinds contribute to it.\n\n## What the result means\n\nCompares the kind-atlas counts and required IDs with the saved system graph and reports each category's shortfall, rejecting a mismatched debt count or a claim that an absent entry proves something does not exist. The small static fixture lacks the graph and is expected to block.\n\n## Verification\n\nWhen `make component-replays` runs this component, the shared [Dafny-verified replay admission](../formal/replay/README.md) checks observed source and input identities, claim-policy identity, and receipt agreement. The example above runs directly and does not invoke that gate. There is no component-specific formal proof of the coverage computation; the tests do not establish completeness.\n\n## Source\n\n[Implementation](../src/microcosm_core/organs/self_ignorance_coverage_ledger.py) · [input](../examples/self_ignorance_coverage_ledger/exported_self_ignorance_coverage_ledger_bundle) · [tests](../tests/test_self_ignorance_coverage_ledger.py) · [historical sample result](../receipts/runtime_shell/demo_project/organs/self_ignorance_coverage_ledger/exported_self_ignorance_coverage_ledger_bundle_validation_result.json) · [component record](../core/paper_module_capsules.json).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/self_ignorance_coverage_ledger/exported_self_ignorance_coverage_ledger_bundle_validation_result.json","guide_example":{"command":"microcosm self-ignorance-coverage-ledger run --input fixtures/first_wave/self_ignorance_coverage_ledger/input --out receipts/first_wave/self_ignorance_coverage_ledger","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/self_ignorance_coverage_ledger.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[self_ignorance_coverage_ledger].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"exported_self_ignorance_coverage_ledger_bundle","input_ref":"examples/self_ignorance_coverage_ledger/exported_self_ignorance_coverage_ledger_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/self_ignorance_cover