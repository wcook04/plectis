ture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.annex_knowledge_routing","primary_guide_ref":"paper_modules/annex_knowledge_routing.md","registered_runner_ref":"src/microcosm_core/organs/annex_knowledge_routing.py","replay_id":"replay::annex_knowledge_routing","requirements_review":{"status":"unrecorded"},"summary":"Ranks a supplied catalogue with explainable weighted keyword and phrase matching.","title":"Rank a small catalogue by keyword overlap"},"claim_ceiling":"Ranks a sanitized in-memory annex catalog against a problem statement using explainable tiered weighted-token retrieval over bounded public fixtures: structured routing fields score highest, family text and open-first summaries weaker, curated notes weakest, with an exact/phrase/token-overlap score per tier and a per-row match breakdown. It rejects unroutable problems by recomputation, returning no_match when no candidate scores above zero or a filter excludes every candidate. It is not BM25, not TF-IDF, not embedding or semantic search, does not clone repositories, ships no private annex corpus, and is not a license, provenance, or release authority.","claim_ceiling_restated":"Ranks an in-memory catalogue by weighted keyword and phrase matches against a problem statement, rejecting a candidate with no overlapping terms or outside the domain filter.","claim_id":"claim::annex_knowledge_routing","evidence_class":"bounded_runtime_computation","evidence_strength_rank":4,"organ_id":"annex_knowledge_routing","truth_accounting_bucket":"real_runtime_receipt","validator_command":"python -m microcosm_core.organs.annex_knowledge_routing run --input fixtures/first_wave/annex_knowledge_routing/input --out receipts/first_wave/annex_knowledge_routing --acceptance-out receipts/acceptance/first_wave/annex_knowledge_routing_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"28112e2f495500938f5819a05b656d15438edfceac62274aa8b2f46512bb69fa","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"bounded_runtime_computation","family":"architecture_and_navigation","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_runtime_receipt"},"component_id":"annex_knowledge_routing","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.annex_knowledge_routing","plain":"A catalogue of entries only helps if a person can find the ones that fit their problem. This ranking tool reads a written problem and a small catalogue, where each entry has routing labels, family text, a summary and notes. It counts the words and phrases the problem shares with each entry, weighting routing labels most, then family text, then summary and notes. It returns a ranked list showing what matched in each entry, so a person can pick the best fit, or reports no match when nothing overlaps or a chosen filter excludes every entry.","plain_availability":"available","ref":"paper_modules/annex_knowledge_routing.md","sha256":"5933d95fed12b39465bfe540bb72fd96b9def1b01162b075ff910c7866930900","text":"# Rank a small catalogue by keyword overlap\n\n> **In plain terms.** A catalogue of entries only helps if a person can find the ones that fit their problem. This ranking tool reads a written problem and a small catalogue, where each entry has routing labels, family text, a summary and notes. It counts the words and phrases the problem shares with each entry, weighting routing labels most, then family text, then summary and notes. It returns a ranked list showing what matched in each entry, so a person can pick the best fit, or reports no match when nothing overlaps or a chosen filter excludes every entry.\n\nThe annex router takes a problem statement and an in-memory catalogue, scores matching terms and returns ranked entries with a breakdown of their matches. Structured routing fields receive the highest weight, followed by family text, summaries and notes. Optional domain and cluster filters restrict the candidates.\n\nThe fixture runner checks positive matches and two negative cases: no overlapping terms and a domain filter that excludes the candidates. In both cases the router returns `no_match`. The component uses weighted token and phrase matching, not semantic or embedding search. It searches only the supplied catalogue and does not establish licensing or provenance.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer and the repository dependencies available:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.annex_knowledge_routing \\\n  run --input fixtures/first_wave/annex_knowledge_routing/input \\\n  --out .microcosm/component-guides/annex_knowledge_routing/output \\\n  --acceptance-out .microcosm/component-guides/annex_knowledge_routing/acceptance.json\n```\n\nThe result records each fixture case, including its top match or `no_match` and the match breakdown. It is written under `.microcosm/component-guides/annex_knowledge_routing/output`; the acceptance receipt is separate. These paths do not overwrite the checked-in receipts.\n\n## Verification\n\nTests and fixtures exercise the keyword matching and negative fixture cases; they do not formally prove the ranking algorithm. The command above runs directly, without the shared admission gate. `make component-replays` separately runs the registered fixture route through the [Dafny-verified admission decision](../formal/replay/README.md), checking the host's observations of source and input identities, claim policy and receipt agreement.\n\n## Source\n\n[Implementation](../src/microcosm_core/organs/annex_knowledge_routing.py) · [fixture input](../fixtures/first_wave/annex_knowledge_routing/input/) · [tests](../tests/test_engine_room_annex_knowledge_router.py) · [sample result (historical)](../receipts/first_wave/annex_knowledge_routing/annex_knowledge_routing_result.json) · [JSON record](annex_knowledge_routing.json). [Scoring implementation](../src/microcosm_core/engine_room/annex_knowledge_router.py).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/annex_knowledge_routing/annex_knowledge_routing_result.json","guide_example":{"command":"microcosm annex-knowledge-routing run --input fixtures/first_wave/annex_knowledge_routing/input --out receipts/first_wave/annex_knowledge_routing --acceptance-out receipts/acceptance/first_wave/annex_knowledge_routing_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/annex_knowledge_routing.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[annex_knowledge_routing].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"annex_knowledge_routing_fixture_cases","input_ref":"fixtures/first_wave/annex_knowledge_routing/input","last_result":{"artifact_ref":"receipts/acceptance/first_wave/annex_knowledge_routing_fixture_acceptance.json","artifact_sha256":"eb9f2eb1a5ad07d346df335a457e0fbf1ce90b0fa647a549a2b44da6db7c2552","availability":"available","c