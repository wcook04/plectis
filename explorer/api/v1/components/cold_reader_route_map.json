_route_map_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.cold_reader_route_map","primary_guide_ref":"paper_modules/cold_reader_route_map.md","registered_runner_ref":"src/microcosm_core/organs/cold_reader_route_map.py","replay_id":"replay::cold_reader_route_map","requirements_review":{"status":"unrecorded"},"summary":"Checks introductory command entries and local references.","title":"Check quickstart commands and their references"},"claim_ceiling":"validates declared public contract only","claim_ceiling_restated":"Matches the introductory commands and descriptions to the public text and resolves their documentation anchors, rejecting an entry with a missing command or receipt reference.","claim_id":"claim::cold_reader_route_map","evidence_class":"semantic_validator","evidence_strength_rank":5,"organ_id":"cold_reader_route_map","truth_accounting_bucket":"real_import_validation","validator_command":"python -m microcosm_core.organs.cold_reader_route_map run --input fixtures/first_wave/cold_reader_route_map/input --out receipts/first_wave/cold_reader_route_map"},"claim_clause_coverage":{"claim_text_sha256":"803dee36585b3b5457034bc188b5bc133ebd31a8c658eb87dca5a73e530cd5ce","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"semantic_validator","family":"entry_and_reveal","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_import_validation"},"component_id":"cold_reader_route_map","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.cold_reader_route_map","plain":"The getting-started commands in a project's documentation can go stale as the project changes, and maintainers need to spot which ones have. This check reads a list of those commands, each with links to documentation sections and to saved results of earlier runs. It searches the project's public text for each command, follows each link to its heading, and checks from each saved result that the earlier run passed. For every command it reports whether the text supports it and whether its links and results hold up, so maintainers can fix stale entries.","plain_availability":"available","ref":"paper_modules/cold_reader_route_map.md","sha256":"87860d400aaaa034455e5a807663670686d89438eec8783da33182f71ed54244","text":"# Check quickstart commands and their references\n\n> **In plain terms.** The getting-started commands in a project's documentation can go stale as the project changes, and maintainers need to spot which ones have. This check reads a list of those commands, each with links to documentation sections and to saved results of earlier runs. It searches the project's public text for each command, follows each link to its heading, and checks from each saved result that the earlier run passed. For every command it reports whether the text supports it and whether its links and results hold up, so maintainers can fix stale entries.\n\n`cold_reader_route_map` validates a JSON list of introductory commands. Each route includes documentation links, saved result links and a description of what a reader should see. The validator checks these against public source text and local files so maintainers can find stale quickstart entries.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or later:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.cold_reader_route_map run \\\n  --input fixtures/first_wave/cold_reader_route_map/input \\\n  --out .microcosm/component-guides/cold_reader_route_map \\\n  --acceptance-out .microcosm/component-guides/cold_reader_route_map/acceptance.json\n```\n\nThe command writes result, board and validation JSON. Inspect the source-replay rows for each command's text support, resolved documentation anchors and saved results with passing status.\n\n## What this checks\n\nThe validator requires the configured routes and their ordering. It looks for command terms and claimed descriptive signals in the source/documentation corpus, resolves heading links, and reads linked JSON results. An exported-bundle test changes a command to `microcosm hallucinated-import`; validation blocks with `COLD_ROUTE_COMMAND_SOURCE_UNSUPPORTED`. Separate tests change a heading anchor or a linked result's status.\n\n## Limits\n\nText matching does not execute each route or prove that a command behaves as described. A link to a passing historical result is evidence of that saved run, not a fresh execution. These checks can detect several forms of documentation drift but cannot establish that a newcomer understands the instructions.\n\n## Verification\n\nThe direct example does not invoke the shared gate. In `make component-replays`, this component’s registered route passes through the [Dafny replay admission check](../formal/replay/README.md), which checks source, input, claim-policy and receipt agreement over host-supplied observations. It does not prove this component’s algorithm.\n\n## Sources\n\n- [Implementation](../src/microcosm_core/organs/cold_reader_route_map.py), [route inputs](../fixtures/first_wave/cold_reader_route_map/input) and [tests](../tests/test_cold_reader_route_map.py).\n- [Historical result](../receipts/first_wave/cold_reader_route_map/cold_reader_route_map_result.json) and [canonical description](../core/paper_module_capsules.json).\n- [Diátaxis](https://diataxis.fr/) provides a documentation framework, rather than a validation guarantee.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/cold_reader_route_map/exported_cold_reader_route_map_bundle_validation_result.json","guide_example":{"command":"microcosm cold-reader-route-map run-route-map-bundle --input examples/cold_reader_route_map/exported_cold_reader_route_map_bundle --out receipts/runtime_shell/demo_project/organs/cold_reader_route_map --card","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/cold_reader_route_map.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[cold_reader_route_map].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"exported_cold_reader_route_map_bundle","input_ref":"examples/cold_reader_route_map/exported_cold_reader_route_map_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/cold_reader_route_map_fixture_acceptance.json","artifact_sha256":"412d6d82c3b33c9e7c5b08fb4a564f797f9977e5f6f796cdb2c25c70744d4b98","availability":"available","created_at":"2026-05-26T10:35:39+00:00","freshness":"historical_saved_artifact","input_mode":"first_wave_fixture","native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"cold_reader_route_map","prerequisites_ref":"Makefile","prerequisites_status":"not_asses