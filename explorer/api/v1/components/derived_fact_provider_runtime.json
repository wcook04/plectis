/first_wave/derived_fact_provider_runtime/derived_fact_provider_runtime_result.json","receipts/first_wave/derived_fact_provider_runtime/derived_fact_provider_runtime_board.json","receipts/first_wave/derived_fact_provider_runtime/derived_fact_provider_runtime_validation_receipt.json","receipts/acceptance/first_wave/derived_fact_provider_runtime_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.derived_fact_provider_runtime","primary_guide_ref":"paper_modules/derived_fact_provider_runtime.md","registered_runner_ref":"src/microcosm_core/organs/derived_fact_provider_runtime.py","replay_id":"replay::derived_fact_provider_runtime","requirements_review":{"status":"unrecorded"},"summary":"Resolves registry facts by JSON pointer, glob and named callable.","title":"Resolve facts from a fixture registry"},"claim_ceiling":"Exercises a registry-backed derived fact provider over bounded public fixture roots: it resolves json_pointer (RFC 6901, including list-index traversal), glob_count (with excluded prefixes), and named callable facts (git-tracked counts), and it turns provider failures into error-as-data rows that degrade the receipt status rather than crash the ledger. Positive cases must resolve to the expected values with a clean receipt; negative cases must be rejected by recomputation with the expected provider error_class firing on the planted-defect fact. It is not a doctrine truth auditor, not a full macro fact-registry export, not semantic claim validation, and it does not authorize release or publication.","claim_ceiling_restated":"Resolves facts in the fixture registries by JSON pointer, glob and named callable, rejecting a missing source path or an unknown provider type.","claim_id":"claim::derived_fact_provider_runtime","evidence_class":"bounded_runtime_computation","evidence_strength_rank":4,"organ_id":"derived_fact_provider_runtime","truth_accounting_bucket":"real_runtime_receipt","validator_command":"python -m microcosm_core.organs.derived_fact_provider_runtime run --input fixtures/first_wave/derived_fact_provider_runtime/input --out receipts/first_wave/derived_fact_provider_runtime --acceptance-out receipts/acceptance/first_wave/derived_fact_provider_runtime_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"b07193b7b38c02982c9e5165b86dd6efc9bbe8bcaa1ac6ce5fd9cd0f037a78df","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"bounded_runtime_computation","family":"research_and_science_replays","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_runtime_receipt"},"component_id":"derived_fact_provider_runtime","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.derived_fact_provider_runtime","plain":"Answering questions about files, such as how many there are, takes a repeatable recipe, and one missing file should not stop the other answers. This component is given a short list of fact recipes and a temporary example folder of files. Each recipe reads one value from a data file, counts files whose names match a pattern, or counts the files a version-tracking tool follows. The output lists each value found, shows a missing file as an error entry instead of stopping, and rejects an unknown kind of recipe.","plain_availability":"available","ref":"paper_modules/derived_fact_provider_runtime.md","sha256":"e371bd901c8f6fdaf469bd26505ded3520cd0de60a99bbbab1be21e6df500605","text":"# Resolve facts from a fixture registry\n\n> **In plain terms.** Answering questions about files, such as how many there are, takes a repeatable recipe, and one missing file should not stop the other answers. This component is given a short list of fact recipes and a temporary example folder of files. Each recipe reads one value from a data file, counts files whose names match a pattern, or counts the files a version-tracking tool follows. The output lists each value found, shows a missing file as an error entry instead of stopping, and rejects an unknown kind of recipe.\n\n`derived_fact_provider_runtime` evaluates small registries of facts against temporary fixture roots. A fact can read a JSON value by pointer, count files by glob, or call a named Git-index counter. The result reports values and provider errors as data, so a missing source does not crash the entire ledger.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or later and Git on `PATH`:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.derived_fact_provider_runtime run \\\n  --input fixtures/first_wave/derived_fact_provider_runtime/input \\\n  --out .microcosm/component-guides/derived_fact_provider_runtime \\\n  --acceptance-out .microcosm/component-guides/derived_fact_provider_runtime/acceptance.json\n```\n\nThe runner creates temporary case roots, evaluates the registries and writes result, board, validation and acceptance JSON. The positive pointer-and-glob case expects a count of seven from a JSON document and two Markdown files. The callable case uses a temporary Git index; it counts tracked files, not untracked ones.\n\n## What this checks\n\nThe engine implements JSON Pointer escaping and list indices, glob exclusions and named callable lookup. In the missing-source case it returns a `FileNotFoundError` row and a degraded provider receipt; an unknown provider type is also rejected. The runner recomputes the cases and checks the expected values and error classes.\n\n## Limits\n\nA resolved value is a fact about the supplied files and registry recipe. It does not establish that a prose claim based on that value is true, or validate a complete external fact registry. Git is needed for the callable fixture.\n\n## Verification\n\nThe direct example does not invoke the shared gate. In `make component-replays`, this component’s registered route passes through the [Dafny replay admission check](../formal/replay/README.md), which checks source, input, claim-policy and receipt agreement over host-supplied observations. It does not prove this component’s algorithm.\n\n## Sources\n\n- [Runner](../src/microcosm_core/organs/derived_fact_provider_runtime.py), [provider engine](../src/microcosm_core/engine_room/derived_fact_provider_engine.py), [fixture cases](../fixtures/first_wave/derived_fact_provider_runtime/input) and [engine tests](../tests/test_engine_room_derived_fact_provider_engine.py).\n- [Historical result](../receipts/first_wave/derived_fact_provider_runtime/derived_fact_provider_runtime_result.json) and [component record](../core/paper_module_capsules.json).\n- [RFC 6901](https://www.rfc-editor.org/rfc/rfc6901) specifies JSON Pointer.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/derived_fact_provider_runtime/derived_fact_provider_runtime_result.json","guide_example":{"command":"microcosm derived-fact-provider-runtime run --input fixtures/first_wave/derived_fact_provider_runtime/input --out receipts/first_wave/derived_fact_provider_runtime --acceptance-out receipts/acceptance/first_wave/derived_fact_provider_runtime_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/derived_fact_provider_runtime.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[derived_fact_provider_runtime].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"derived_fact_provider_registry_fixture_cases","input_ref":"fixtures/first_wave/derived_fact_provider_runtime/input","last_result":{"artifact_ref":"receipts/acceptance/first_wave/derived_fact_provider_runtime_fixture_acceptance.json","artifact_sha256":"876f6860898f64f4a40388f6af70aa1cb3ccdd5d0c4431521aec8c5a27fe81e5","availability":"available","created_at":null,"freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"derived_fact_provider_runtime","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["plectis","component-replay","derived_fact_provider_runtime"],"implementation_state":"companion_external_backend_proposal","input_override_supported":false,"kind":"fixed_component_replay_api","organ_id":"derived_fact_provider_runtime","output_policy":"fresh ignored .microcosm/component-replays run under selected checkout","scope":"single_registered_component","worker_schema":"plectis_component_replay_worker_v1"},"receipt_name":"derived_fact_provider_runtime_result.json","replay_id":"replay::derived_fact_provider_runtime","runner_ref":"src/microcosm_core/organs/derived_fact_provider_runtime.py#run_derived_fact_provider_runtime_bundle","span":"derived_fact_provider_runtime.validate"},"requirements_revi