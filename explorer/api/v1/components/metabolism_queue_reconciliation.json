ounded_runtime_computation","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/metabolism_queue_reconciliation/metabolism_queue_reconciliation_result.json","receipts/first_wave/metabolism_queue_reconciliation/metabolism_queue_reconciliation_board.json","receipts/first_wave/metabolism_queue_reconciliation/metabolism_queue_reconciliation_validation_receipt.json","receipts/acceptance/first_wave/metabolism_queue_reconciliation_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.metabolism_queue_reconciliation","primary_guide_ref":"paper_modules/metabolism_queue_reconciliation.md","registered_runner_ref":"src/microcosm_core/organs/metabolism_queue_reconciliation.py","replay_id":"replay::metabolism_queue_reconciliation","requirements_review":{"status":"unrecorded"},"summary":"Runs temporary SQLite queue cases and checks their reconciliation outcomes.","title":"Queue reconciliation in a temporary SQLite store"},"claim_ceiling":"Exercises a synthetic SQLite durable-queue capsule over bounded public fixtures: an active-idempotency uniqueness guard, lease claim and expired-lease recovery to a recoverable state, a blackboard claim-event projection where a contradiction invalidates an assertion, and a cold-start reconciliation taxonomy over the job/run/log triple. It rejects inconsistent store states by recomputation, asserting the expected reconciliation rule id fires. It does not ship the private live metabolism database, does not dispatch agents or call providers, does not auto-repair ambiguous state, is not a distributed database, and does not authorize release or publication.","claim_ceiling_restated":"Runs synthetic queue cases in temporary SQLite databases and checks that the reconciler rejects a running job with no run row and a finished run whose job is still running.","claim_id":"claim::metabolism_queue_reconciliation","evidence_class":"bounded_runtime_computation","evidence_strength_rank":4,"organ_id":"metabolism_queue_reconciliation","truth_accounting_bucket":"real_runtime_receipt","validator_command":"python -m microcosm_core.organs.metabolism_queue_reconciliation run --input fixtures/first_wave/metabolism_queue_reconciliation/input --out receipts/first_wave/metabolism_queue_reconciliation --acceptance-out receipts/acceptance/first_wave/metabolism_queue_reconciliation_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"23f256521ccb29ef9b647f0fd509904a8d8689a734209216a393f765e80a55cf","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"bounded_runtime_computation","family":"agent_reliability_and_safety","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_runtime_receipt"},"component_id":"metabolism_queue_reconciliation","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.metabolism_queue_reconciliation","plain":"A queue of jobs for programs to work on can contradict itself, for example a job marked as running that has no run on record. This component is given made-up queue scenarios, each run in a temporary database, such as lending a job out and recovering it when the loan expires. A checker then compares the job, run and log records against its consistency rules and reports whether the outcome matches what each scenario expects. Where a contradiction is planted on purpose, success means the expected rule fires.","plain_availability":"available","ref":"paper_modules/metabolism_queue_reconciliation.md","sha256":"570fb736a526fbe3bbbb7fe287063c3728ec637eb99ce234e76d36f9bd0eefdc","text":"# Queue reconciliation in a temporary SQLite store\n\n> **In plain terms.** A queue of jobs for programs to work on can contradict itself, for example a job marked as running that has no run on record. This component is given made-up queue scenarios, each run in a temporary database, such as lending a job out and recovering it when the loan expires. A checker then compares the job, run and log records against its consistency rules and reports whether the outcome matches what each scenario expects. Where a contradiction is planted on purpose, success means the expected rule fires.\n\nRuns queue scenarios in temporary SQLite stores and reports whether the reconciliation rules match each case’s expectation.\n\n## Run the example\n\nFrom the repository root with Python 3.11 or newer:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.metabolism_queue_reconciliation run --input fixtures/first_wave/metabolism_queue_reconciliation/input --out .microcosm/component-guides/metabolism_queue_reconciliation --acceptance-out .microcosm/component-guides/metabolism_queue_reconciliation/acceptance.json --json\n```\n\nInspect the status and findings in `.microcosm/component-guides/`; the linked result below is a historical sample.\n\n## What it checks\n\nThe cases exercise idempotent enqueue, leases and expired-lease recovery, plus a blackboard projection. The reconciler examines job, run and log records. A running job without a run row, or a finalised run whose job is still running, is a named negative case. A negative case succeeds when the expected rule fires; the inconsistent queue is not thereby healthy.\n\n## Limits\n\nRuns synthetic queue cases in temporary SQLite databases and checks that the reconciler rejects a running job with no run row and a finished run whose job is still running.\n\n## Verification\n\nThe focused tests exercise this component’s checks; they do not prove its algorithm. `make component-replays` runs its registered queue fixture cases through the shared [Dafny admission check](../formal/replay/README.md), which checks source, input, claim-policy and receipt agreement within the host’s observations. The direct command above does not itself invoke that admission gate.\n\n## Source and evidence\n\n- [Implementation](../src/microcosm_core/organs/metabolism_queue_reconciliation.py) and [focused tests](../tests/test_engine_room_metabolism_runtime.py)\n- [Example input](../fixtures/first_wave/metabolism_queue_reconciliation/input/running_job_no_run_row_rejected.json) and [historical sample result](../receipts/first_wave/metabolism_queue_reconciliation/metabolism_queue_reconciliation_result.json)\n- [Component JSON record](./metabolism_queue_reconciliation.json) and [canonical capsule](../core/paper_module_capsules.json)\n- [Supporting implementation](../src/microcosm_core/engine_room/metabolism_runtime.py)\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/metabolism_queue_reconciliation/metabolism_queue_reconciliation_result.json","guide_example":{"command":"microcosm metabolism-queue-reconciliation run --input fixtures/first_wave/metabolism_queue_reconciliation/input --out receipts/first_wave/metabolism_queue_reconciliation --acceptance-out receipts/acceptance/first_wave/metabolism_queue_reconciliation_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/metabolism_queue_reconciliation.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths",