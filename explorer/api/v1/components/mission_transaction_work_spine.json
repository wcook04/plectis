tation","evidence_strength_rank":4,"organ_id":"mission_transaction_work_spine","truth_accounting_bucket":"real_runtime_receipt","validator_command":"python -m microcosm_core.organs.mission_transaction_work_spine run --input fixtures/first_wave/mission_transaction_work_spine/input --out receipts/first_wave/mission_transaction_work_spine"},"claim_clause_coverage":{"claim_text_sha256":"59dcd28ace8ae81785d87e7b223731e8b19065e6ab3af2f8fd113e5477e6321c","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"bounded_runtime_computation","family":"work_landing_and_continuity","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_runtime_receipt"},"component_id":"mission_transaction_work_spine","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.mission_transaction_work_spine","plain":"Workers saving changes to one project can claim the same files or build on an outdated version. This component reads a made-up example of workers' claims on files, the project version each expected, which tasks wait on which, and rules for a limited save. It lists the active claims, compares each with its files and expected version, and tests whether finished tasks unlock waiting ones and the save rules are met. The output is a verdict with findings, and it rejects a claim built on an outdated version or two claims on one file.","plain_availability":"available","ref":"paper_modules/mission_transaction_work_spine.md","sha256":"decfcf7b66e5b10478f82d5b0cf42d2344aa25e3f528c0dff90dd6754041593d","text":"# Work-landing transaction replay\n\n> **In plain terms.** Workers saving changes to one project can claim the same files or build on an outdated version. This component reads a made-up example of workers' claims on files, the project version each expected, which tasks wait on which, and rules for a limited save. It lists the active claims, compares each with its files and expected version, and tests whether finished tasks unlock waiting ones and the save rules are met. The output is a verdict with findings, and it rejects a claim built on an outdated version or two claims on one file.\n\nValidates a public work-transaction fixture containing path claims, dependencies, preflight and checkpoint policy, and writes receipts.\n\n## Run the example\n\nFrom the repository root with Python 3.11 or newer:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.mission_transaction_work_spine run --input fixtures/first_wave/mission_transaction_work_spine/input --out /tmp/plectis-component-guides/mission_transaction_work_spine/out\n```\n\nInspect the status and findings under `/tmp/plectis-component-guides/mission_transaction_work_spine/out`. The command also writes a preflight receipt under `/tmp/plectis-component-guides/mission_transaction_work_spine/receipts/preflight/`; the linked result below is a historical sample.\n\n## What it checks\n\nThe replay reconstructs an active-claims snapshot using imported public-safe Work Ledger code. It checks claims against paths and expected parent state, dependency unlocks and scoped checkpoint policy. Tests change a same-path conflict to a disjoint claim and change an expected parent to check that the verdict follows the input. A stale expected parent or conflicting claim is rejected.\n\n## Limits\n\nRebuilds an active-claims snapshot from the fixture with copied Work Ledger code and checks claims, parent state, dependency unlocks and checkpoint policy, rejecting a stale expected parent or a conflicting claim.\n\n## Verification\n\nThe focused tests exercise this component’s checks; they do not prove its algorithm. `make component-replays` runs its registered exported work-transaction bundle through the shared [Dafny admission check](../formal/replay/README.md), which checks source, input, claim-policy and receipt agreement within the host’s observations. The direct command above does not itself invoke that admission gate.\n\n## Source and evidence\n\n- [Implementation](../src/microcosm_core/organs/mission_transaction_work_spine.py) and [focused tests](../tests/test_mission_transaction_work_spine.py)\n- [Example input](../fixtures/first_wave/mission_transaction_work_spine/input) and [historical sample result](../receipts/first_wave/mission_transaction_work_spine/claim_preflight_result.json)\n- [Component JSON record](./mission_transaction_work_spine.json) and [canonical capsule](../core/paper_module_capsules.json)\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/mission_transaction_work_spine/exported_mission_transaction_bundle_validation_result.json","guide_example":{"command":"microcosm mission-transaction-work-spine run --input fixtures/first_wave/mission_transaction_work_spine/input --out receipts/first_wave/mission_transaction_work_spine","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/mission_transaction_work_spine.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[mission_transaction_work_spine].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_reta