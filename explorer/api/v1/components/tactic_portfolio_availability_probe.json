irst_wave/tactic_portfolio_availability_probe"},"claim_clause_coverage":{"claim_text_sha256":"59dcd28ace8ae81785d87e7b223731e8b19065e6ab3af2f8fd113e5477e6321c","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"algorithmic_projection","family":"formal_math_and_proof","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"source_faithful_refactor"},"component_id":"tactic_portfolio_availability_probe","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.tactic_portfolio_availability","plain":"Lean, a program that checks proofs, has automatic methods called tactics, and which of them work depends on the setup. This component is given a table of tactics with their recorded outcomes, timings and environment details, such as whether the Mathlib library was present, plus the original test files behind them. It checks the table against those files, rejecting a tactic called available with no recorded outcome and a Mathlib claim with no evidence. The output is an availability report that a later step can use when choosing which tactic to try.","plain_availability":"available","ref":"paper_modules/tactic_portfolio_availability.md","sha256":"57d24fcdfd70f3c8bb172028ff59422327596b9267e25ef8353d49230151c71f","text":"# Tactic availability from recorded probes\n\n> **In plain terms.** Lean, a program that checks proofs, has automatic methods called tactics, and which of them work depends on the setup. This component is given a table of tactics with their recorded outcomes, timings and environment details, such as whether the Mathlib library was present, plus the original test files behind them. It checks the table against those files, rejecting a tactic called available with no recorded outcome and a Mathlib claim with no evidence. The output is an availability report that a later step can use when choosing which tactic to try.\n\nThis component reads recorded tactic compile statuses, durations and environment information and produces an availability report for later routing. The included records describe a particular Lean/Std probe, including whether Mathlib was available.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer available:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.tactic_portfolio_availability_probe run \\\n  --input fixtures/first_wave/tactic_portfolio_availability_probe/input \\\n  --out .microcosm/component-guides/tactic_portfolio_availability_probe \\\n  --acceptance-out .microcosm/component-guides/tactic_portfolio_availability_probe/acceptance.json\n```\n\nThe command writes local output under `.microcosm/component-guides/`. Check the returned status and the result receipt; a blocked result reports findings for the supplied inputs.\n\n## What this checks\n\nThe validator compares public tactic and environment rows with source-backed probe artifacts. A row claiming an available tactic without a compile status, or claiming Mathlib availability without supporting evidence, is rejected. Source changes can invalidate a recorded availability label.\n\n## Limits\n\nCompares the recorded tactic and environment rows with probe artifacts from source, and rejects a tactic marked available without a compile status or Mathlib marked available without evidence.\n\n## Verification\n\nTests exercise specific cases; no component-specific formal proof of its algorithm is established. When its exported-bundle route runs through `make component-replays`, the [shared Dafny-verified admission check](../formal/replay/README.md) checks agreement of source, input, claim-policy and receipt observations. The direct fixture command above does not itself run that check.\n\n## Source\n\n[Implementation](../src/microcosm_core/organs/tactic_portfolio_availability_probe.py) · [Example input](../fixtures/first_wave/tactic_portfolio_availability_probe/input/) · [Tests](../tests/test_tactic_portfolio_availability_probe.py) · [Historical sample result](../receipts/first_wave/tactic_portfolio_availability_probe/tactic_portfolio_availability_result.json) · [JSON record](tactic_portfolio_availability.json)\n\nBackground: [Lean tactics](https://lean-lang.org/theorem_proving_in_lean4/Tactics/).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/tactic_portfolio_availability_probe/exported_tactic_portfolio_availability_bundle_validation_result.json","guide_example":{"command":"PYTHONPATH=src python3 -m microcosm_core.organs.tactic_portfolio_availability_probe run --input fixtures/first_wave/tactic_portfolio_availability_probe/input --out receipts/first_wave/tactic_portfolio_availability_probe --acceptance-out receipts/acceptance/first_wave/tactic_portfolio_availability_probe_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/tactic_portfolio_availability.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[tactic_portfolio_availability_probe].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"exported_