ndex == -1 && preference == -1\n      invariant forall k :: 0 <= k < i ==> !Match(cs, ps[k])\n      decreases |ps| - i\n    {\n      var j := 0;\n      while j < |cs|\n        invariant 0 <= j <= |cs|\n        invariant index == -1 && preference == -1\n        invariant forall k :: 0 <= k < i ==> !Match(cs, ps[k])\n        invariant forall k :: 0 <= k < j ==> !(cs[k].id == ps[i] && Eligible(cs[k]))\n        decreases |cs| - j\n      {\n        if cs[j].id == ps[i] && Eligible(cs[j]) {\n          index := j;\n          preference := i;\n          return;\n        }\n        j := j + 1;\n      }\n      assert !Match(cs, ps[i]);\n      i := i + 1;\n    }\n    var j := 0;\n    while j < |cs|\n      invariant 0 <= j <= |cs|\n      invariant index == -1 && preference == -1\n      invariant !AnyPreference(ps, cs)\n      invariant forall k :: 0 <= k < j ==> !Eligible(cs[k])\n      decreases |cs| - j\n    {\n      if Eligible(cs[j]) {\n        index := j;\n        return;\n      }\n      j := j + 1;\n    }\n  }\n","text_sha256":"d3c4fa3e48462c439bd40382895ad4be1ee1f67b918c03f3a08e1fe7225cebf1"}],"fresh_prover_result":{"status":"not_run_by_index"},"generated_refs":["src/plectis/components/tactic_selection/_generated/System_/__init__.py","src/plectis/components/tactic_selection/_generated/TacticSelection.py","src/plectis/components/tactic_selection/_generated/__main__.py","src/plectis/components/tactic_selection/_generated/_dafny/__init__.py","src/plectis/components/tactic_selection/_generated/module_.py"],"guide":{"availability":"available","plain":null,"plain_availability":"unrecorded","ref":"formal/components/tactic_selection/README.md","sha256":"34c2af590818c5d68bccab01c674db21a1a0b9607813621f6f6a6ea09abef8a1","text":"# Tactic selection decision core\n\n`Select` receives an ordered preference list and ordered candidate observations. Each candidate carries a normalized identity and booleans saying whether it is known, available and allowed. It selects the first preference w