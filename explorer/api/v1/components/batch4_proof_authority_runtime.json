e/first_wave/batch4_proof_authority_runtime_fixture_acceptance.json","evidence_class":"verified_macro_body_import","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/batch4_proof_authority_runtime/batch4_proof_authority_runtime_result.json","receipts/first_wave/batch4_proof_authority_runtime/batch4_proof_authority_runtime_board.json","receipts/first_wave/batch4_proof_authority_runtime/batch4_proof_authority_runtime_validation_receipt.json","receipts/acceptance/first_wave/batch4_proof_authority_runtime_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.batch4_proof_authority_runtime","primary_guide_ref":"paper_modules/batch4_proof_authority_runtime.md","registered_runner_ref":"src/microcosm_core/organs/batch4_proof_authority_runtime.py","replay_id":"replay::batch4_proof_authority_runtime","requirements_review":{"status":"unrecorded"},"summary":"This fixture checks source manifests and exercises selected proof, permission and runtime cases.","title":"Inspect proof and authority boundaries"},"claim_ceiling":"verified non-secret macro body import only, not source authority, private-root equivalence, release, or publication","claim_ceiling_restated":"Checks copied-source manifests and anchors, scans the copied Lean source for placeholder tokens and rejects an overclaimed Erdős solution. An optional probe compiles that file when Lean, Lake, the source Lake project and its dependencies are present, and reports compiled, failed or unavailable.","claim_id":"claim::batch4_proof_authority_runtime","evidence_class":"verified_macro_body_import","evidence_strength_rank":5,"organ_id":"batch4_proof_authority_runtime","truth_accounting_bucket":"copied_non_secret_macro_body","validator_command":"python -m microcosm_core.organs.batch4_proof_authority_runtime run --input fixtures/first_wave/batch4_proof_authority_runtime/input --out receipts/first_wave/batch4_proof_authority_runtime --acceptance-out receipts/acceptance/first_wave/batch4_proof_authority_runtime_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"e74e2d1858b5ae982235243bc5a0a2b186cf029107241b077fe6ea520527f441","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"verified_macro_body_import","family":"formal_math_and_proof","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"copied_non_secret_macro_body"},"component_id":"batch4_proof_authority_runtime","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.batch4_proof_authority_runtime","plain":"Having the code for a proof or permission check is not the same as that check making a decision. The component reads a list of copied program files and a few example cases. It searches the files for the code behind decisions such as rejecting a bundle whose fingerprint does not match, and scans a copied proof file for placeholders standing in for missing proofs. It also checks an example where Erdős problem 257 is wrongly claimed solved and, if the tools are installed, reports whether the proof file builds, fails or could not be tried.","plain_availability":"available","ref":"paper_modules/batch4_proof_authority_runtime.md","sha256":"e72618c1976af0d888e9e083030f39c143624321eee6a51f22e536dde17fafe7","text":"# Inspect proof and authority boundaries\n\n> **In plain terms.** Having the code for a proof or permission check is not the same as that check making a decision. The component reads a list of copied program files and a few example cases. It searches the files for the code behind decisions such as rejecting a bundle whose fingerprint does not match, and scans a copied proof file for placeholders standing in for missing proofs. It also checks an example where Erdős problem 257 is wrongly claimed solved and, if the tools are installed, reports whether the proof file builds, fails or could not be tried.\n\nThis fixture checks source manifests and exercises selected proof, permission and runtime cases. Its result distinguishes source and fixture observations from claims about an actual proof or authorization decision.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer and the project dependencies installed:\n\n```sh\nPYTHONPATH=src python3 -m microcosm_core.organs.batch4_proof_authority_runtime run \\\n  --input fixtures/first_wave/batch4_proof_authority_runtime/input \\\n  --out .microcosm/component-guides/batch4_proof_authority_runtime/result \\\n  --acceptance-out .microcosm/component-guides/batch4_proof_authority_runtime/acceptance.json --card\n```\n\nThe command prints a compact JSON card and writes its results under `.microcosm/component-guides/`. A passing run returns exit code 0; a blocked run returns 1.\n\n## What this checks\n\nThe fixture checks copied-source anchors for packet digest rejection, forbidden context grants and stale closeout handling; those checks do not execute the corresponding decisions. It scans the copied Lean source for placeholder tokens and checks an Erdős solution-overclaim case. An optional Lean/Lake probe can report whether the copied file compiles, fails or is unavailable.\n\n## Verification\n\nThe direct example runs the fixture; its optional Lean probe checks whether the copied `CertificateKernel.lean` elaborates, when its toolchain and project prerequisites are available. In `make component-replays`, the exported bundle also uses the [shared Dafny admission check](../formal/replay/README.md) for source, input, claim-policy and receipt agreement. Neither check proves an Erdős solution or the component’s algorithms.\n\n## Limits\n\nChecks copied-source manifests and anchors, scans the copied Lean source for placeholder tokens and rejects an overclaimed Erdős solution. An optional probe compiles that file when Lean, Lake, the source Lake project and its dependencies are present, and reports compiled, failed or unavailable.\n\n## Source and evidence\n\nRead the [implementation](../src/microcosm_core/organs/batch4_proof_authority_runtime.py), [fixture input](../fixtures/first_wave/batch4_proof_authority_runtime/input/batch4_probe_manifest.json), and [focused tests](../tests/test_batch4_proof_authority_runtime.py). The [saved acceptance result](../receipts/acceptance/first_wave/batch4_proof_authority_runtime_fixture_acceptance.json) is historical sample evidence, not the result of your run. The [JSON record](batch4_proof_authority_runtime.json) identifies the module; the canonical capsule metadata is in [paper_module_capsules.json](../core/paper_module_capsules.json).\n\nProof-carrying code is related background: see [Necula’s work](https://en.wikipedia.org/wiki/Proof-carrying_code).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/batch4_proof_authority_runtime/exported_batch4_proof_authority_runtime_bundle_validation_result.json","guide_example":{"command":"microcosm batch4-proof-authority-runtime run --input fixtures/first_wave/batch4_proof_authority_runtime/input --out receipts/first_wave/batch4_proof_authority_runtime --acceptance-out receipts/acceptance/first_wave/batch4_proof_authority_runtime_fixture_acceptance.json","expected_result_descripti