y_index","historical_receipt_refs":["receipts/first_wave/cognitive_operator_registry/cognitive_operator_registry_result.json","receipts/first_wave/cognitive_operator_registry/cognitive_operator_registry_board.json","receipts/first_wave/cognitive_operator_registry/cognitive_operator_registry_validation_receipt.json","receipts/acceptance/first_wave/cognitive_operator_registry_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.cognitive_operator_registry","primary_guide_ref":"paper_modules/cognitive_operator_registry.md","registered_runner_ref":"src/microcosm_core/organs/cognitive_operator_registry.py","replay_id":"replay::cognitive_operator_registry","requirements_review":{"status":"unrecorded"},"summary":"Checks a registry of procedures and cited use records.","title":"Validate a registry of reusable reasoning procedures"},"claim_ceiling":"validates declared public contract only","claim_ceiling_restated":"Checks each procedure's required fields, status and cited use records, flags unresolved references, and rejects a record that claims more than its evidence shows.","claim_id":"claim::cognitive_operator_registry","evidence_class":"semantic_validator","evidence_strength_rank":5,"organ_id":"cognitive_operator_registry","truth_accounting_bucket":"real_import_validation","validator_command":"python -m microcosm_core.organs.cognitive_operator_registry run --input fixtures/first_wave/cognitive_operator_registry/input --out receipts/first_wave/cognitive_operator_registry"},"claim_clause_coverage":{"claim_text_sha256":"803dee36585b3b5457034bc188b5bc133ebd31a8c658eb87dca5a73e530cd5ce","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"semantic_validator","family":"architecture_and_navigation","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_import_validation"},"component_id":"cognitive_operator_registry","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.cognitive_operator_registry","plain":"A list of reusable reasoning procedures can mark an entry as active without any record that it ever changed a decision. This check reads descriptions of each procedure, with a status, and the use records cited for the active ones. It checks each entry has the required fields and a recognised status, and that every active entry's use record cites evidence that can be found. It writes a result and a summary sheet, so a maintainer can find unsupported entries before presenting them as tested.","plain_availability":"available","ref":"paper_modules/cognitive_operator_registry.md","sha256":"5ecea49db5bc154ebc2b829352f5cb3b27dfe9523ff795cdffd84ac9e97010ad","text":"# Validate a registry of reusable reasoning procedures\n\n> **In plain terms.** A list of reusable reasoning procedures can mark an entry as active without any record that it ever changed a decision. This check reads descriptions of each procedure, with a status, and the use records cited for the active ones. It checks each entry has the required fields and a recognised status, and that every active entry's use record cites evidence that can be found. It writes a result and a summary sheet, so a maintainer can find unsupported entries before presenting them as tested.\n\n`cognitive_operator_registry` checks JSON descriptions of reasoning procedures and the records cited for their use. An entry marked `active` must include a use record with resolvable references to the claimed change in a decision. This helps a registry maintainer find unsupported entries before presenting them as tested procedures.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or later:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.cognitive_operator_registry run \\\n  --input fixtures/first_wave/cognitive_operator_registry/input \\\n  --out .microcosm/component-guides/cognitive_operator_registry \\\n  --acceptance-out .microcosm/component-guides/cognitive_operator_registry/acceptance.json\n```\n\nThe output includes a result, a summary board and a validation record. A passing run means the supplied positive records satisfy the validator and the required negative cases produce their expected errors.\n\n## What this checks\n\nThe validator requires descriptive fields and recognised statuses, resolves active entries' use records, and checks the references in `cognition_delta_evidence`. A test replaces one reference with `cognition_delta_evidence://fabricated/not-present`; the run then blocks with `COGOP_COGNITION_DELTA_EVIDENCE_UNRESOLVABLE`. Other cases exercise duplicate entries, missing use records and unsupported permission claims. Source-copy manifests are checked by digest.\n\n## Limits\n\nResolving a record establishes that its cited reference exists, not that the procedure caused an improvement or is generally correct. The fixture does not execute the listed procedures. Its content scan uses configured exclusions; it is not a guarantee that every secret can be detected.\n\n## Verification\n\nThe direct example does not invoke the shared gate. In `make component-replays`, this component’s registered route passes through the [Dafny replay admission check](../formal/replay/README.md), which checks source, input, claim-policy and receipt agreement over host-supplied observations. It does not prove this component’s algorithm.\n\n## Sources\n\n- [Implementation](../src/microcosm_core/organs/cognitive_operator_registry.py), [inputs](../fixtures/first_wave/cognitive_operator_registry/input) and [tests](../tests/test_cognitive_operator_registry.py).\n- [Historical result](../receipts/first_wave/cognitive_operator_registry/cognitive_operator_registry_result.json) and [canonical component descriptions](../core/paper_module_capsules.json).\n- [W3C PROV](https://www.w3.org/TR/prov-overview/) describes provenance records; it does not certify these procedures.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/cognitive_operator_registry/exported_cognitive_operator_registry_bundle_validation_result.json","guide_example":{"command":"PYTHONPATH=src python3 -m microcosm_core.organs.cognitive_operator_registry run --input fixtures/first_wave/cognitive_operator_registry/input --out /tmp/cognitive_operator_registry_out","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/cognitive_operator_registry.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[cognitive_operator_registry].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":false},"input_mode":"exported_cognitive_operator_registry_bundle","input_ref":"examples/cognitive_operator_registry/exported_cognitive_operator_registry_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/cognitive_operator_registry_fixture_acceptance.json","artifact_sha256":"a04344c7bb70e735a2bab8c772e4d91b99138b48b313da1e5b78e9c2119b1b5b","availability":"available","created_at":"2026-06-02T07:41:57+00:00","freshness":"historical_saved_artifact","input_mod