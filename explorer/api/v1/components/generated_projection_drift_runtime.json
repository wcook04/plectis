b5f3ce567053e00ed56d6cb431fa6c1608824412d572","evidence":{"authority_availability":"available","authority_receipt_ref":"receipts/acceptance/first_wave/generated_projection_drift_runtime_fixture_acceptance.json","evidence_class":"external_subprocess_witness","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/generated_projection_drift_runtime/generated_projection_drift_runtime_result.json","receipts/first_wave/generated_projection_drift_runtime/generated_projection_drift_runtime_board.json","receipts/first_wave/generated_projection_drift_runtime/generated_projection_drift_runtime_validation_receipt.json","receipts/acceptance/first_wave/generated_projection_drift_runtime_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.generated_projection_drift_runtime","primary_guide_ref":"paper_modules/generated_projection_drift_runtime.md","registered_runner_ref":"src/microcosm_core/organs/generated_projection_drift_runtime.py","replay_id":"replay::generated_projection_drift_runtime","requirements_review":{"status":"unrecorded"},"summary":"This runtime exercises a generated-file drift gate using fixture owners.","title":"Generated Projection Drift Runtime"},"claim_ceiling":"Exercises an owner-routed generated projection drift gate over bounded public fixtures: per-file SHA-256 fingerprinting of source authorities and artifacts, a prior-clean-receipt source-hash skip cache, required-artifact presence, and each owner's declared no-write check command return code. It reports a drifted owner by recomputation. It does not prove that every macro owner uses true content-diff semantics, does not repair files, does not validate the full macro registry, and does not authorize public release.","claim_ceiling_restated":"Fingerprints each fixture owner's sources and generated files, reuses a matching clean receipt, and otherwise checks that the artifacts exist and runs the owner's check command, reporting a missing artifact as drift instead of regenerating it.","claim_id":"claim::generated_projection_drift_runtime","evidence_class":"external_subprocess_witness","evidence_strength_rank":4,"organ_id":"generated_projection_drift_runtime","truth_accounting_bucket":"real_runtime_receipt","validator_command":"python -m microcosm_core.organs.generated_projection_drift_runtime run --input fixtures/first_wave/generated_projection_drift_runtime/input --out receipts/first_wave/generated_projection_drift_runtime --acceptance-out receipts/acceptance/first_wave/generated_projection_drift_runtime_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"556d7ad2055e6b0220bc73a036326b663ac6ecd4a92b62d2edd7c75c48c9b486","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"external_subprocess_witness","family":"import_projection_and_drift","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_runtime_receipt"},"component_id":"generated_projection_drift_runtime","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.generated_projection_drift_runtime","plain":"Files made automatically from other files can fall out of step with their sources. This check is given example setups, each naming source files, the files generated from them, and a check that changes nothing. It fingerprints the sources and generated files, reuses an earlier clean result if the fingerprint matches, and otherwise checks that each generated file exists and runs the setup's own check. It reports the outcome, leaving every file as it found it, and treats a missing file as out of step even when the setup's own check passes.","plain_availability":"available","ref":"paper_modules/generated_projection_drift_runtime.md","sha256":"80d39e99cd21626d29a9fd217577bd703af8d7700f7f29a6b74b24453074b428","text":"# Generated Projection Drift Runtime\n\n> **In plain terms.** Files made automatically from other files can fall out of step with their sources. This check is given example setups, each naming source files, the files generated from them, and a check that changes nothing. It fingerprints the sources and generated files, reuses an earlier clean result if the fingerprint matches, and otherwise checks that each generated file exists and runs the setup's own check. It reports the outcome, leaving every file as it found it, and treats a missing file as out of step even when the setup's own check passes.\n\nThis runtime exercises a generated-file drift gate using fixture owners. An owner names source files, generated artifacts, and a no-write check. The gate fingerprints the inputs and outputs, can reuse a prior clean receipt when its fingerprint matches, and otherwise checks artifact presence and the owner's command. It reports the outcome; it does not repair or regenerate files.\n\nThe fixture includes a planted extra byte and a missing artifact. The missing artifact is drift even when the owner's check command returns success. A clean result is limited to the declared files and checks: a hash match is not a proof of semantic correctness or a validation of every generated file in the repository.\n\n## Run the example\n\nFrom the repository root with Python 3.11 or newer, run the supplied fixture into ignored local output:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.generated_projection_drift_runtime run \\\n  --input fixtures/first_wave/generated_projection_drift_runtime/input \\\n  --out .microcosm/component-guides/generated_projection_drift_runtime/out \\\n  --acceptance-out .microcosm/component-guides/generated_projection_drift_runtime/acceptance.json\n```\n\nA successful fixture run reports `pass` for four cases, including the two expected drift detections.\n\nThe fixture executes its declared built-in checks in temporary directories.\n\n## Verification\n\nThe direct fixture exercises the drift checks without formally proving them. `make component-replays` runs this fixture route through the [shared Dafny admission check](../formal/replay/README.md), checking agreement among supplied source, input, claim policy and receipt observations. It does not prove that every drift is detected. The direct example does not invoke the admission check.\n\n## Source and evidence\n\n- [Implementation](../src/microcosm_core/organs/generated_projection_drift_runtime.py) and [fixture inputs](../fixtures/first_wave/generated_projection_drift_runtime/input/).\n- [Tests](../tests/test_engine_room_generated_projection_drift_gate.py).\n- [Saved example result](../receipts/first_wave/generated_projection_drift_runtime/generated_projection_drift_runtime_result.json) (historical, not a fresh run).\n- [Component JSON record](./generated_projection_drift_runtime.json) and [canonical capsule](../core/paper_module_capsules.json).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/generated_projection_drift_runtime/generated_projection_drift_runtime_result.json","guide_example":{"command":"microcosm generated-projection-drift-runtime run --input fixtures/first_wave/generated_projection_drift_runtime/input --out receipts/first_wave/generated_projection_drift_runtime --acceptance-out receipts/acceptance/first_wave/generated_projection_drift_runtime_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/generated_projection_drift_runtime.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[generated_projection_drift_runtime].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"generated_projection_drift_gate_fixture_cases","input_ref":"fixtures/first_wave/generated_projection_drift_runtime/input","last_result":{"artifact_ref":"receipts/acceptance/first_wave/generated_projection_drift_runtime_fixture_acceptance.json","artifact_sha256":"0b8f33a7bcc38498bbe8a96b5c62f2735e8615c48ba00ed30fb1b906729ec7a1","availability":"available","created_at":null,"freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"generated_projection_drift_runtime","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["plectis","component-replay","generated_projection_drift_runtime"],"implementation_state":"companion_external_backend_proposal","input_override_supported":false,"kind":"fixed_component_replay_api","organ_id":"generated_projection_drift_runtime","output_policy":"fresh ignored .microcosm/component-replays run under selected checkout","scope":"single_registered_component","worker_schema":"plectis_component_replay_worker_v1"},"receipt_name":"generated_projection_drift_runtime_result.json","replay_i