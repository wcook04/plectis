_receipt","validator_command":"python -m microcosm_core.organs.corpus_readiness_mathlib_absence_gate run --input fixtures/first_wave/corpus_readiness_mathlib_absence_gate/input --out receipts/first_wave/corpus_readiness_mathlib_absence_gate"},"claim_clause_coverage":{"claim_text_sha256":"59dcd28ace8ae81785d87e7b223731e8b19065e6ab3af2f8fd113e5477e6321c","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"external_subprocess_witness","family":"formal_math_and_proof","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_runtime_receipt"},"component_id":"corpus_readiness_mathlib_absence_gate","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.corpus_readiness_mathlib_absence_gate","plain":"A written claim that Mathlib, a large shared library of mathematics, is ready to use can be wrong. The checker is given a saved record of which libraries were available and what each example user needs. It compares those claims with saved evidence and runs a small test in which Lean, a proof-checking program, must load its basic library but fail to load Mathlib with a 'module missing' message. It marks each example user as allowed or blocked and rejects any record that says Mathlib is available without evidence.","plain_availability":"available","ref":"paper_modules/corpus_readiness_mathlib_absence.md","sha256":"2bdc7911cdbc48a696fc375b9388b94730c1d4872d35c8905d5ab749a155a123","text":"# Check corpus readiness and a Mathlib absence case\n\n> **In plain terms.** A written claim that Mathlib, a large shared library of mathematics, is ready to use can be wrong. The checker is given a saved record of which libraries were available and what each example user needs. It compares those claims with saved evidence and runs a small test in which Lean, a proof-checking program, must load its basic library but fail to load Mathlib with a 'module missing' message. It marks each example user as allowed or blocked and rejects any record that says Mathlib is available without evidence.\n\nThis checker compares declared formal-math corpus readiness and consumer decisions with supplied source artifacts and a narrow Lean import probe. It records which fixture consumers are allowed or blocked, so an absent corpus or unsupported Mathlib claim cannot silently become a readiness result.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or later and Lean and Lake available on `PATH`:\n\n```bash\nPYTHONPATH=src python3 - <<'PYTHON'\nfrom microcosm_core.organs.corpus_readiness_mathlib_absence_gate import run\nresult = run(\n    'fixtures/first_wave/corpus_readiness_mathlib_absence_gate/input',\n    '.microcosm/component-guides/corpus_readiness_mathlib_absence_gate',\n    acceptance_out='.microcosm/component-guides/corpus_readiness_mathlib_absence_gate/acceptance.json',\n)\nprint(result['status'])\nPYTHON\n```\n\nThis uses the Python API because the `run` CLI does not expose an acceptance-output override. The probe runs `lake env lean` in a temporary directory: a `Std` import must succeed and the Mathlib import must fail with the expected missing-module diagnostic. Missing tools, timeouts or a different failure do not establish Mathlib absence.\n\n## What this checks\n\nThe 2026 fixture records corpus status and consumer requirements; the checker compares aliases and decisions against the anchored runtime evidence and checks source artifact digests. A fixture that claims Mathlib is available without supporting probe evidence is rejected. The historical inputs describe that run's corpus state, not an inventory of this checkout today.\n\n## Limits\n\nThe temporary import probe is not a build of a Mathlib project, a theorem proof or a benchmark. A passing result does not establish corpus completeness or global Mathlib availability. A digest match identifies an unchanged artifact; it does not prove its claims.\n\n## Verification\n\nThe shown run uses Lean and Lake for the narrow `Std` and Mathlib import probes, not to prove the readiness checker. The registered bundle replay also runs the probe and applies the [Dafny replay admission check](../formal/replay/README.md) to its observed envelope; the direct example does not invoke that admission gate.\n\n## Sources\n\n- [Implementation](../src/microcosm_core/organs/corpus_readiness_mathlib_absence_gate.py), [fixture inputs](../fixtures/first_wave/corpus_readiness_mathlib_absence_gate/input) and [tests](../tests/test_corpus_readiness_mathlib_absence_gate.py).\n- [Historical result](../receipts/first_wave/corpus_readiness_mathlib_absence_gate/corpus_readiness_mathlib_absence_gate_result.json) and [component record](../core/paper_module_capsules.json).\n- [Mathlib](https://leanprover-community.github.io/mathlib4_docs/) documents the library independently of this probe.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/corpus_readiness_mathlib_absence_gate/exported_corpus_readiness_bundle_validation_result.json","guide_example":{"command":"PYTHONPATH=src python3 -m microcosm_core.organs.corpus_readiness_mathlib_absence_gate run --input fixtures/first_wave/corpus_readiness_mathlib_absence_gate/input --out receipts/first_wave/corpus_readiness_mathlib_absence_gate","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/corpus_readiness_mathlib_absence.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[corpus_readiness_mathlib_absence_gate].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"exported_corpus_readiness_bundle","input_ref":"examples/corpus_readiness_mathlib_absence_gate/exported_corpus_readiness_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/corpus_readiness_mathlib_absence_gate_fixture_acceptance.json","artifact_sha256":"b597eacb5ca59fbab7c278f729d9fc95572ee17aefaafc04d23116af05e5c5cf","availability":"available","created_at":"2026-05-23T06:41:11+00:00","freshness":"historical_saved_artifact","input_mode":"first_wave_fixture","native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"corpus_readiness_mathlib_absence_gate","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["plectis","component-replay","corpus_readiness_mathlib_absence_gate"],"implementation_state":"companion_external_backend_proposal","input_override_supported":false,"kind":"fixed_component_replay_api","organ_id":"corpus_readiness_mathlib_absence_gate","output_policy":"fresh ignored .microcosm/component-replays run under selected checkout","scope":"single_registered_component","worker_schema":"plectis_component_replay_worker_v1"},"receipt_name":"exported_corpus_readiness_bundle_validation_result.json","replay