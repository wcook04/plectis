ne_self_improvement_loop","evidence_class":"semantic_validator","evidence_strength_rank":5,"organ_id":"voice_to_doctrine_self_improvement_loop","truth_accounting_bucket":"real_import_validation","validator_command":"python -m microcosm_core.organs.voice_to_doctrine_self_improvement_loop run --input fixtures/first_wave/voice_to_doctrine_self_improvement_loop/input --out receipts/first_wave/voice_to_doctrine_self_improvement_loop --acceptance-out receipts/acceptance/first_wave/voice_to_doctrine_self_improvement_loop_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"803dee36585b3b5457034bc188b5bc133ebd31a8c658eb87dca5a73e530cd5ce","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"semantic_validator","family":"architecture_and_navigation","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_import_validation"},"component_id":"voice_to_doctrine_self_improvement_loop","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.voice_to_doctrine_self_improvement_loop","plain":"A lesson learned on a project should reach whoever owns the relevant guidance, be checked and be closed out. This check reads a policy for how lessons may spread, plus records naming each lesson's trigger, owner, action, check and closing step. It follows each reference, compares each lesson with the allowed sequence, and rejects a lesson promoted project-wide without its owner's check. It writes a report with no private text so the records can be inspected, and it rejects raw spoken remarks or private discussions in the input.","plain_availability":"available","ref":"paper_modules/voice_to_doctrine_self_improvement_loop.md","sha256":"122d24538e1381e5234bfabd02aa0485b0cda0ddde17823abac8b2d2ed6b1f8e","text":"# Validate a lesson-to-owner record\n\n> **In plain terms.** A lesson learned on a project should reach whoever owns the relevant guidance, be checked and be closed out. This check reads a policy for how lessons may spread, plus records naming each lesson's trigger, owner, action, check and closing step. It follows each reference, compares each lesson with the allowed sequence, and rejects a lesson promoted project-wide without its owner's check. It writes a report with no private text so the records can be inspected, and it rejects raw spoken remarks or private discussions in the input.\n\nThis validator checks public records that connect a local lesson to an owner surface, validation and closeout. It reads a propagation policy, owner-surface references and lesson rows, and writes a body-free report.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer available:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.voice_to_doctrine_self_improvement_loop run \\\n  --input fixtures/first_wave/voice_to_doctrine_self_improvement_loop/input \\\n  --out .microcosm/component-guides/voice_to_doctrine_self_improvement_loop \\\n  --acceptance-out .microcosm/component-guides/voice_to_doctrine_self_improvement_loop/acceptance.json\n```\n\nThe command writes local output under `.microcosm/component-guides/`. Check the returned status and the result receipt; a blocked result reports findings for the supplied inputs.\n\n## Public Mechanics\n\nThe checks resolve referenced public paths and anchors and compare each lesson with the declared sequence and allowed outcomes. A record claiming global promotion without owner validation is rejected, as is treating a receipt alone as progress. Tests mutate references to ensure the result follows the actual target rather than a stored expected label.\n\n## Reader Proof Boundary\n\nResolves the public paths and anchors that link each lesson to its owner, validation and closeout, rejecting a global promotion without owner validation or a receipt counted as progress on its own.\n\n## Public-Safe Body Handling\n\nPublic records use references rather than exporting raw operator voice or private thread bodies. The validator rejects either body in the public input.\n\n## Shape\n\nA lesson names the pressure, its owner surface, the action or capture, validation and closeout. These fields make the record inspectable; they do not perform the action.\n\n## Anti-Claim\n\nA passing record is evidence of the checked public contract, not permission to promote doctrine or modify a live ledger.\n\n## Verification\n\nTests exercise specific cases; no component-specific formal proof of its algorithm is established. When its exported-bundle route runs through `make component-replays`, the [shared Dafny-verified admission check](../formal/replay/README.md) checks agreement of source, input, claim-policy and receipt observations. The direct fixture command above does not itself run that check.\n\n## Source\n\n[Implementation](../src/microcosm_core/organs/voice_to_doctrine_self_improvement_loop.py) · [Example input](../fixtures/first_wave/voice_to_doctrine_self_improvement_loop/input/) · [Tests](../tests/test_voice_to_doctrine_self_improvement_loop.py) · [Historical sample result](../receipts/first_wave/voice_to_doctrine_self_improvement_loop/voice_to_doctrine_self_improvement_loop_result.json) · [JSON record](voice_to_doctrine_self_improvement_loop.json)\n\nBackground: [NASA Lessons Learned Information System](https://llis.nasa.gov/).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/voice_to_doctrine_self_improvement_loop/exported_voice_to_doctrine_bundle_validation_result.json","guide_example":{"command":"PYTHONPATH=src python3 -m microcosm_core.organs.voice_to_doctrine_self_improvement_loop run --input fixtures/first_wave/voice_to_doctrine_self_improvement_loop/input --out receipts/first_wave/voice_to_doctrine_self_improvement_loop","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/voice_to_doctrine_self_improvement_loop.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[voice_to_doctrine_self_improvement_loop].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"exported_voice_to_doctrine_bundle","input_ref":"examples/voice_to_doctrine_self_improvement_loop/exported_voice_to_doctrine_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/voice_to_doctrine_self_improvement_loop_fixture_acceptance.json","artifact_sha256":"4466568353163d7b301e6f7637b6bf13d6a7f8407db29dd9bb83065b012685ce","availability":"available","created_at":"2026-05-27T05:32:21+00:00","freshness":"historical_saved_artifact","input_mode":"first_wave_fixture","native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"voice_to_doctrine_self_improvement_loop","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["pl