ceptance/first_wave/prediction_oracle_reconciliation_fixture_acceptance.json","evidence_class":"algorithmic_projection","fresh_run_status":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/prediction_oracle_reconciliation/prediction_oracle_reconciliation_result.json","receipts/first_wave/prediction_oracle_reconciliation/prediction_reconciliation_board.json","receipts/first_wave/prediction_oracle_reconciliation/prediction_oracle_validation_receipt.json","receipts/acceptance/first_wave/prediction_oracle_reconciliation_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.prediction_oracle_reconciliation","primary_guide_ref":"paper_modules/prediction_oracle_reconciliation.md","registered_runner_ref":"src/microcosm_core/organs/prediction_oracle_reconciliation.py","replay_id":"replay::prediction_oracle_reconciliation","requirements_review":{"status":"unrecorded"},"summary":"Compares synthetic predictions with supplied evidence and outcomes.","title":"Prediction and oracle reconciliation"},"claim_ceiling":"projection mechanics only, not domain correctness","claim_ceiling_restated":"Recomputes rankings and grades for synthetic predictions against supplied evidence and outcomes, rejecting an oracle row without a prediction, a grade that contradicts recomputation, and evidence dated after the prediction used as prior evidence.","claim_id":"claim::prediction_oracle_reconciliation","evidence_class":"algorithmic_projection","evidence_strength_rank":3,"organ_id":"prediction_oracle_reconciliation","truth_accounting_bucket":"source_faithful_refactor","validator_command":"python -m microcosm_core.organs.prediction_oracle_reconciliation run --input fixtures/first_wave/prediction_oracle_reconciliation/input --out receipts/first_wave/prediction_oracle_reconciliation"},"claim_clause_coverage":{"claim_text_sha256":"59dcd28ace8ae81785d87e7b223731e8b19065e6ab3af2f8fd113e5477e6321c","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"algorithmic_projection","family":"research_and_science_replays","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"source_faithful_refactor"},"component_id":"prediction_oracle_reconciliation","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.prediction_oracle_reconciliation","plain":"A price prediction is graded unfairly if the grading uses evidence from after the prediction was made. This component is given a made-up packet of predictions, the evidence cited for each, and rows recording the realised outcomes. It checks each prediction's target and evidence dates, works out the numeric rankings again and grades the realised direction of each outcome. It writes a result and rejects an outcome with no matching prediction, a grade that disagrees with the one it works out, and later evidence used as if it came earlier.","plain_availability":"available","ref":"paper_modules/prediction_oracle_reconciliation.md","sha256":"f2021cb5c583f3a314622c2d45af83bef75ff4512f28f53610bfd7b8b8225d1d","text":"# Prediction and oracle reconciliation\n\n> **In plain terms.** A price prediction is graded unfairly if the grading uses evidence from after the prediction was made. This component is given a made-up packet of predictions, the evidence cited for each, and rows recording the realised outcomes. It checks each prediction's target and evidence dates, works out the numeric rankings again and grades the realised direction of each outcome. It writes a result and rejects an outcome with no matching prediction, a grade that disagrees with the one it works out, and later evidence used as if it came earlier.\n\nChecks a synthetic prediction packet against supplied evidence and realised outcomes, then emits a reconciliation result.\n\n## Run the example\n\nFrom the repository root with Python 3.11 or newer:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.prediction_oracle_reconciliation run-prediction-bundle --input examples/prediction_oracle_reconciliation/exported_prediction_oracle_bundle --out .microcosm/component-guides/prediction_oracle_reconciliation --card\n```\n\nInspect the status and findings in `.microcosm/component-guides/`; the linked result below is a historical sample.\n\n## What it checks\n\nThe validator checks prediction targets and evidence timing, recomputes numeric rankings and grades supplied realised directions. It keeps stock and ETF counts separate and constrains dossier mutations to declared types and evidence. It rejects an oracle row without a supporting prediction, a claimed grade contradicting recomputation, and post-prediction evidence used as prior evidence.\n\n## Limits\n\nRecomputes rankings and grades for synthetic predictions against supplied evidence and outcomes, rejecting an oracle row without a prediction, a grade that contradicts recomputation, and evidence dated after the prediction used as prior evidence.\n\n## Verification\n\nThe focused tests exercise this component’s checks; they do not prove its algorithm. `make component-replays` runs its registered exported prediction bundle through the shared [Dafny admission check](../formal/replay/README.md), which checks source, input, claim-policy and receipt agreement within the host’s observations. The direct command above does not itself invoke that admission gate.\n\n## Source and evidence\n\n- [Implementation](../src/microcosm_core/organs/prediction_oracle_reconciliation.py) and [focused tests](../tests/test_prediction_oracle_reconciliation.py)\n- [Example input](../fixtures/first_wave/prediction_oracle_reconciliation/input/reconciliation_packet.json) and [historical sample result](../receipts/first_wave/prediction_oracle_reconciliation/prediction_oracle_reconciliation_result.json)\n- [Component JSON record](./prediction_oracle_reconciliation.json) and [canonical capsule](../core/paper_module_capsules.json)\n\nFor forecast evaluation context see the [Brier score](https://journals.ametsoc.org/doi/10.1175/1520-0493%281950%29078%3C0001%3AVOFEIT%3E2.0.CO%3B2), [Gneiting and Raftery on proper scoring rules](https://sites.stat.washington.edu/people/raftery/Research/PDF/Gneiting2007jasa.pdf), and [Hanson on market scoring rules](https://hanson.gmu.edu/mktscore.pdf). These are background, not claims that this replay implements those methods.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/prediction_oracle_reconciliation/exported_prediction_oracle_bundle_validation_result.json","guide_example":{"command":"PYTHONPATH=src python3 -m microcosm_core.organs.prediction_oracle_reconciliation run --input fixtures/first_wave/prediction_oracle_reconciliation/input --out receipts/first_wave/prediction_oracle_reconciliation","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/prediction_oracle_reconciliation.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[prediction_oracle_reconciliation].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":t