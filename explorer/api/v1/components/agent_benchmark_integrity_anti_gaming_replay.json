runtime validation over digest-verified copied macro pattern provenance bodies and body-free benchmark-integrity replay rows only; not benchmark scores, SWE-bench performance, provider execution, live repo mutation, product progress, or release authority","claim_ceiling_restated":"Checks recorded benchmark runs against the locked evaluator IDs and configuration hashes and recomputes their integrity verdicts from file-access and contamination evidence, rejecting cases such as an evaluator edit or train–test leakage.","claim_id":"claim::agent_benchmark_integrity_anti_gaming_replay","evidence_class":"algorithmic_projection","evidence_strength_rank":3,"organ_id":"agent_benchmark_integrity_anti_gaming_replay","truth_accounting_bucket":"source_faithful_refactor","validator_command":"python -m microcosm_core.organs.agent_benchmark_integrity_anti_gaming_replay run --input fixtures/first_wave/agent_benchmark_integrity_anti_gaming_replay/input --out receipts/first_wave/agent_benchmark_integrity_anti_gaming_replay"},"claim_clause_coverage":{"claim_text_sha256":"8ba8f72df85615cc9091a5244af515d3501c76941c66aa87451b40de8574c987","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"algorithmic_projection","family":"agent_reliability_and_safety","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"source_faithful_refactor"},"component_id":"agent_benchmark_integrity_anti_gaming_replay","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.agent_benchmark_integrity_anti_gaming_replay","plain":"A test score for an artificial intelligence program means little if it saw the answers or the grading was altered. This component is given three example records of test runs, the locked grading rules, and evidence of which files each run opened and whether test material leaked in. It checks that each record names the locked grader and settings, works out whether the run kept to the rules, and rejects any record whose written verdict disagrees. A reader examining how a test claim was recorded can see each verdict, two passes and one set aside in the example.","plain_availability":"available","ref":"paper_modules/agent_benchmark_integrity_anti_gaming_replay.md","sha256":"1b0d73881fec42ddfd0fd51231d0d25dd27322357c0bd17640e5b8fb63bb73ea","text":"# Benchmark integrity replay\n\n> **In plain terms.** A test score for an artificial intelligence program means little if it saw the answers or the grading was altered. This component is given three example records of test runs, the locked grading rules, and evidence of which files each run opened and whether test material leaked in. It checks that each record names the locked grader and settings, works out whether the run kept to the rules, and rejects any record whose written verdict disagrees. A reader examining how a test claim was recorded can see each verdict, two passes and one set aside in the example.\n\nThis replay checks whether recorded benchmark runs agree with a locked evaluator policy and their supporting evidence. It reads public case and replay records, checks evaluator IDs and configuration hashes, and recomputes integrity verdicts from file-access and contamination evidence. Its result is useful when examining how a benchmark claim was recorded; it does not calculate a benchmark score.\n\nThe supplied fixture has three cases. The regression test expects two integrity passes and one quarantine. A mismatched evaluator hash or a declared verdict that disagrees with the recomputed verdict is rejected. The validator also checks source-artifact references and digests; a matching digest establishes the identity of the copied material, not the correctness of its algorithm.\n\nThe records omit private issue and oracle patch bodies. These examples do not establish performance on SWE-bench or any other real benchmark.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer and the repository dependencies available:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.agent_benchmark_integrity_anti_gaming_replay \\\n  run --input fixtures/first_wave/agent_benchmark_integrity_anti_gaming_replay/input \\\n  --out .microcosm/component-guides/agent_benchmark_integrity_anti_gaming_replay/output \\\n  --acceptance-out .microcosm/component-guides/agent_benchmark_integrity_anti_gaming_replay/acceptance.json\n```\n\nThe result lists the computed integrity verdicts, quarantines and findings. It is written under `.microcosm/component-guides/agent_benchmark_integrity_anti_gaming_replay/output`; the acceptance receipt is separate. These paths do not overwrite the checked-in receipts.\n\n## Verification\n\nTests and fixtures exercise the evaluator and contamination checks; they do not formally prove the benchmark integrity algorithm. The command above runs directly, without the shared admission gate. `make component-replays` separately runs the exported benchmark bundle through the [Dafny-verified admission decision](../formal/replay/README.md), checking the host's observations of source and input identities, claim policy and receipt agreement.\n\n## Source\n\n[Implementation](../src/microcosm_core/organs/agent_benchmark_integrity_anti_gaming_replay.py) · [fixture input](../fixtures/first_wave/agent_benchmark_integrity_anti_gaming_replay/input/) · [tests](../tests/test_agent_benchmark_integrity_anti_gaming_replay.py) · [sample result (historical)](../receipts/first_wave/agent_benchmark_integrity_anti_gaming_replay/agent_benchmark_integrity_anti_gaming_replay_result.json) · [JSON record](agent_benchmark_integrity_anti_gaming_replay.json).\n\n[Specification gaming](https://deepmind.google/blog/specification-gaming-the-flip-side-of-ai-ingenuity/) describes the broader problem; this fixture is not a measurement of it.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/agent_benchmark_integrity_anti_gaming_replay/exported_benchmark_integrity_bundle_validation_result.json","guide_example":{"command":"microcosm agent-benchmark-integrity-anti-gaming-replay run-benchmark-integrity-bundle --input examples/agent_benchmark_integrity_anti_gaming_replay/exported_benchmark_integrity_bundle --out .microcosm/agent_benchmark_integrity_anti_gaming_replay","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/agent_benchmark_integrity_anti_gaming_replay.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[agent_benchmark_integrity_anti_gaming_replay].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":false},"input_mode":"exported_benchmark_integrity_bundle","input_ref":"examples/agent_benchmark_integrity_anti_gaming_replay/exported_benchmark_integrity_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/agent_benchmark_integrity_anti_gaming_replay_fixture_acceptance.json","artifact_sha256":"e9356da67c29ea6321d764a96226357de52222a0eadcf8b631de6c49da7e66f1","availability":"available","created_at":"2026-06-02T11:11:38+00:00","freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"agent_benchmark_integrity_anti_gaming_replay","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["plectis","component-replay","agent_benchmark_integrity_anti_gaming_replay"],"implementation_state":"companion_external_backend_proposal","input_override_supported":false,"kind":"fixed_component_replay_api","organ_id":"agent_benchmark_integrity_anti_gaming_replay","output_policy":"fresh ignored .microcosm/component-replays run under selected checkout","scope":"single_registered_component","worker_schema":"plectis_component_replay_worker_v1"},"receipt_name":"exported_benchmark_integrity_bundle_validation_result.json","replay_id":"replay::agent_benchmark_integrity_anti_gaming_replay","runner_ref":"src/microcosm_core/organs/agent_benchmark_integrity_anti_gaming_replay.py#run_benchmark_integrity_bundle","span":"agent_benchmark_integrity.validate"},"requirements_reviews":{"records":[],"status":"unrecorded"},"subclaims":[]},"schema_version":"plectis_component_http_v1","snapshot_revision":"45be1deb333ad57cd9ae093229455d0a52d3bf23a9064cde09f1a6e16f4c7044"}