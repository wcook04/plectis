"receipts/first_wave/doctrine_fact_claim_audit/doctrine_fact_claim_audit_board.json","receipts/first_wave/doctrine_fact_claim_audit/doctrine_fact_claim_audit_validation_receipt.json","receipts/acceptance/first_wave/doctrine_fact_claim_audit_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.doctrine_fact_claim_audit","primary_guide_ref":"paper_modules/doctrine_fact_claim_audit.md","registered_runner_ref":"src/microcosm_core/organs/doctrine_fact_claim_audit.py","replay_id":"replay::doctrine_fact_claim_audit","requirements_review":{"status":"unrecorded"},"summary":"Checks fact counts, code locations, graph references and numeric bindings.","title":"Audit fact references and numeric claims"},"claim_ceiling":"validates declared public contract only","claim_ceiling_restated":"Checks supplied fact assertions against their counts, code locations, graph references and numeric bindings, and rejects an assertion with a missing code location.","claim_id":"claim::doctrine_fact_claim_audit","evidence_class":"semantic_validator","evidence_strength_rank":5,"organ_id":"doctrine_fact_claim_audit","truth_accounting_bucket":"real_import_validation","validator_command":"python -m microcosm_core.organs.doctrine_fact_claim_audit run --input fixtures/first_wave/doctrine_fact_claim_audit/input --out receipts/first_wave/doctrine_fact_claim_audit --acceptance-out receipts/acceptance/first_wave/doctrine_fact_claim_audit_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"803dee36585b3b5457034bc188b5bc133ebd31a8c658eb87dca5a73e530cd5ce","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"semantic_validator","family":"architecture_and_navigation","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_import_validation"},"component_id":"doctrine_fact_claim_audit","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.doctrine_fact_claim_audit","plain":"A project's written guidance states facts, and the references showing where each comes from can break or fall out of step. This check reads a table of stated facts with their code locations, a map of links between facts, and sample text containing numbers. It compares the declared fact count with the actual rows, checks each fact has a code location and each link ends at a real fact, and flags current-state figures with no matching fact section. It reports broken references and mismatched declarations so maintainers can fix them.","plain_availability":"available","ref":"paper_modules/doctrine_fact_claim_audit.md","sha256":"5d13451e982ac4a3bc1daae34b4e3d4126131d98ffd9f101f9fb7eee28cae671","text":"# Audit fact references and numeric claims\n\n> **In plain terms.** A project's written guidance states facts, and the references showing where each comes from can break or fall out of step. This check reads a table of stated facts with their code locations, a map of links between facts, and sample text containing numbers. It compares the declared fact count with the actual rows, checks each fact has a code location and each link ends at a real fact, and flags current-state figures with no matching fact section. It reports broken references and mismatched declarations so maintainers can fix them.\n\n`doctrine_fact_claim_audit` checks a supplied table of fact assertions, their source references and a graph of fact IDs. It also uses a copied numeric-claim detector to find fixture text whose current-state numbers lack a corresponding assertion section. The result helps maintainers find broken references and mismatched declarations.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or later:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.doctrine_fact_claim_audit run \\\n  --input fixtures/first_wave/doctrine_fact_claim_audit/input \\\n  --out .microcosm/component-guides/doctrine_fact_claim_audit \\\n  --acceptance-out .microcosm/component-guides/doctrine_fact_claim_audit/acceptance.json\n```\n\nThe output includes a result, board, validation and acceptance record. The evaluator compares the declared fact count with the actual rows, checks that each fact has a code location and that any specified anchor appears in the copied source, and verifies graph edge endpoints. It also checks the numeric detector's expected results.\n\n## What this checks\n\nThe tests mutate the input to create wrong counts, missing locations, dead graph references and unbound numeric claims. A dead graph endpoint, for example, is rejected rather than accepted merely because a fixture labels it as a failure. Source manifest digests are checked separately from the fact relations.\n\n## Limits\n\nThese checks establish the listed relations over the supplied public fixture. They do not determine whether the assertions themselves are true, prove that the graph covers every useful reading route, or establish that a reader understands the doctrine.\n\n## Verification\n\nThe direct example does not invoke the shared gate. In `make component-replays`, this component’s registered route passes through the [Dafny replay admission check](../formal/replay/README.md), which checks source, input, claim-policy and receipt agreement over host-supplied observations. It does not prove this component’s algorithm.\n\n## Sources\n\n- [Implementation](../src/microcosm_core/organs/doctrine_fact_claim_audit.py), [fixture inputs](../fixtures/first_wave/doctrine_fact_claim_audit/input) and [tests](../tests/test_doctrine_fact_claim_audit.py).\n- [Historical result](../receipts/first_wave/doctrine_fact_claim_audit/doctrine_fact_claim_audit_result.json) and [component record](../core/paper_module_capsules.json).\n- [W3C PROV](https://www.w3.org/TR/prov-overview/) describes provenance records; it does not verify the assertions in this fixture.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/doctrine_fact_claim_audit/exported_doctrine_fact_claim_audit_bundle_validation_result.json","guide_example":{"command":"microcosm doctrine-fact-claim-audit run --input fixtures/first_wave/doctrine_fact_claim_audit/input --out receipts/first_wave/doctrine_fact_claim_audit","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/doctrine_fact_claim_audit.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[doctrine_fact_claim_audit].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"exported_doctrine_fact_claim_audit_bundle","input_ref":"examples/doctrine_fact_claim_audit/exported_doctrine_fact_claim_audit_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/doctrine_fact_claim_audit_fixture_acceptance.json","artifact_sha256":"fec2be6f42634a040fa6b07aad480df2af674eb7d1b3669e1c127653e1d440ac","availability":"available","created_at":null,"freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performe