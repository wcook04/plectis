ormal_subclaim_ids":[],"primary_guide_id":"paper_module.pattern_binding_contract","primary_guide_ref":"paper_modules/pattern_binding_contract.md","registered_runner_ref":"src/microcosm_core/organs/pattern_binding_contract.py","replay_id":"replay::pattern_binding_contract","requirements_review":{"status":"unrecorded"},"summary":"Validates pattern bindings, source references and authority records.","title":"Pattern binding validation"},"claim_ceiling":"validates only the declared public pattern-binding and route-readiness contract over public fixtures, substrate bundle structure, pattern-ledger row refs, binding sidecars, authority handles, and negative cases; does not certify the private pattern ledger, hosted-public readiness, release, publication, provider calls, private-data equivalence, whole-system correctness, or promote mined pattern rows into standalone public leaves","claim_ceiling_restated":"Checks each binding's required fields, references and duplicates, and rejects a missing reference, a conflicting duplicate pattern, a private source body or a public claim larger than its evidence.","claim_id":"claim::pattern_binding_contract","evidence_class":"semantic_validator","evidence_strength_rank":5,"organ_id":"pattern_binding_contract","truth_accounting_bucket":"real_import_validation","validator_command":"python -m microcosm_core.organs.pattern_binding_contract validate --input fixtures/first_wave/pattern_binding_contract/input --out receipts/first_wave/pattern_binding_contract"},"claim_clause_coverage":{"claim_text_sha256":"cb4d8f5a45df0319a4701b770aa7fb2f1695b7a4518bbaf652775257debf5f83","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"semantic_validator","family":"architecture_and_navigation","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_import_validation"},"component_id":"pattern_binding_contract","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.pattern_binding_contract","plain":"A reusable pattern should be tied to the written rule that governs it, to its sources and to its limits. This check reads pattern entries that each name the governing rule, source references and limits, plus records of where its authority comes from. It rejects entries with missing fields or references, conflicting duplicates, private source text, or public claims that go beyond their evidence. It writes a validation result and related saved records, so a maintainer can see which pattern entries are consistent.","plain_availability":"available","ref":"paper_modules/pattern_binding_contract.md","sha256":"7e9c3a88e8f2f173d227db84f0eabd6a1591f9741b3ac8b9731105a50d7580f1","text":"# Pattern binding validation\n\n> **In plain terms.** A reusable pattern should be tied to the written rule that governs it, to its sources and to its limits. This check reads pattern entries that each name the governing rule, source references and limits, plus records of where its authority comes from. It rejects entries with missing fields or references, conflicting duplicates, private source text, or public claims that go beyond their evidence. It writes a validation result and related saved records, so a maintainer can see which pattern entries are consistent.\n\nChecks pattern rows and their source, reference and authority-chain records, producing a validation result and related receipts.\n\n## Run the example\n\nFrom the repository root with Python 3.11 or newer:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.pattern_binding_contract validate --input fixtures/first_wave/pattern_binding_contract/input --out .microcosm/component-guides/pattern_binding_contract --card\n```\n\nInspect the status and findings in `.microcosm/component-guides/`; the linked result below is a historical sample.\n\n## What it checks\n\nA pattern binding links a pattern ID to its governing standard, source references and limits. In the fixture, `pb_valid_synthetic_binding` points to `capsule.synthetic_pattern_contract`, a provenance record for the regression harness. The validator checks required fields, reference resolution, duplicate conflicts and private-body markers. It rejects missing references, conflicting duplicate patterns, private source bodies and public claims that exceed their evidence. A separate route-readiness bundle checks whether selector rows resolve through their owning routes.\n\n## Limits\n\nChecks each binding's required fields, references and duplicates, and rejects a missing reference, a conflicting duplicate pattern, a private source body or a public claim larger than its evidence.\n\n## Verification\n\nThe focused tests exercise this component’s checks; they do not prove its algorithm. `make component-replays` runs its registered exported substrate bundle through the shared [Dafny admission check](../formal/replay/README.md), which checks source, input, claim-policy and receipt agreement within the host’s observations. The direct command above does not itself invoke that admission gate.\n\n## Source and evidence\n\n- [Implementation](../src/microcosm_core/organs/pattern_binding_contract.py) and [focused tests](../tests/test_pattern_binding_contract.py)\n- [Example input](../fixtures/first_wave/pattern_binding_contract/input/patterns.jsonl) and [historical sample result](../receipts/first_wave/pattern_binding_contract/pattern_binding_validation_result.json)\n- [Component JSON record](./pattern_binding_contract.json) and [canonical capsule](../core/paper_module_capsules.json)\n- [Supporting implementation](../src/microcosm_core/macro_tools/pattern_route_readiness.py)\n\nRelated provenance frameworks include [in-toto](https://in-toto.io/), [SLSA](https://slsa.dev/spec/) and [W3C PROV](https://www.w3.org/TR/prov-overview/).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/pattern_binding_contract/exported_substrate_bundle_validation_result.json","guide_example":{"command":"microcosm pattern-route-readiness validate-bundle --input examples/pattern_binding_contract/exported_route_readiness_bundle --out /tmp/microcosm-pattern-route-readiness","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/pattern_binding_contract.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[pattern_binding_contract].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":false},"input_mode":"exported_substrate_bundle","input_ref":"examples/pattern_binding_contract/exported_substrate_bundle","last_result":{"artifact_ref":"receipts/first_wave/pattern_binding_contract/pattern_binding_validation_result.json","artifact_sha256":"804fd9cfc31e2217a620c0c82b25135d15ec3cdb232cb5779f0ca33adba5b9fb","availability":"available","created_at":"2026-05-28T02:30:41+00:00","freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"las