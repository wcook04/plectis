state/microcosm_portfolio/reconstruction/macro_pattern_autonomy_process_runs_v1.jsonl","receipts/first_wave/pattern_assimilation_step/exported_assimilation_bundle_validation_result.json","state/microcosm_portfolio/reconstruction/pattern_assimilation_step_current_authority_build_receipt_v1.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.pattern_assimilation","primary_guide_ref":"paper_modules/pattern_assimilation.md","registered_runner_ref":"src/microcosm_core/validators/acceptance.py","replay_id":"replay::pattern_assimilation_step","requirements_review":{"status":"unrecorded"},"summary":"Checks landed components for linked, same-lane closeout decisions.","title":"Pattern assimilation closeout check"},"claim_ceiling":"validates declared public contract only","claim_ceiling_restated":"Resolves each landed component's closeout decision to a refinement receipt or a `nothing_to_refine` receipt and checks duplicate IDs, rejecting a missing closeout or a dead receipt reference.","claim_id":"claim::pattern_assimilation_step","evidence_class":"semantic_validator","evidence_strength_rank":5,"organ_id":"pattern_assimilation_step","truth_accounting_bucket":"real_import_validation","validator_command":"python -m microcosm_core.validators.acceptance validate-assimilation-bundle --input examples/pattern_assimilation_step/exported_assimilation_bundle --out receipts/first_wave/pattern_assimilation_step"},"claim_clause_coverage":{"claim_text_sha256":"803dee36585b3b5457034bc188b5bc133ebd31a8c658eb87dca5a73e530cd5ce","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"semantic_validator","family":"architecture_and_navigation","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"real_import_validation"},"component_id":"pattern_assimilation_step","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.pattern_assimilation","plain":"Work that has been finished and added to a project should end with a recorded decision about what to improve, if anything. This check reads a list of finished components, each with a closing decision pointing to a saved record of an improvement or of why none was needed. It follows each pointer and rejects a finished component with no closing decision, a dead pointer, or a local improvement claiming to change the project's overall guidance. It writes a validation record, so maintainers can see which finished work lacks a proper closing decision.","plain_availability":"available","ref":"paper_modules/pattern_assimilation.md","sha256":"c8cdc5d2c8661f5bb542c0a14bd9885bcc7fa4f16d174766a5b054de7823977f","text":"# Pattern assimilation closeout check\n\n> **In plain terms.** Work that has been finished and added to a project should end with a recorded decision about what to improve, if anything. This check reads a list of finished components, each with a closing decision pointing to a saved record of an improvement or of why none was needed. It follows each pointer and rejects a finished component with no closing decision, a dead pointer, or a local improvement claiming to change the project's overall guidance. It writes a validation record, so maintainers can see which finished work lacks a proper closing decision.\n\nChecks whether each landed component in an input set has a linked, same-lane closeout decision and writes a validation receipt.\n\n## Run the example\n\nFrom the repository root with Python 3.11 or newer:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.validators.acceptance validate-assimilation-bundle --input examples/pattern_assimilation_step/exported_assimilation_bundle --out .microcosm/component-guides/pattern_assimilation\n```\n\nInspect the status and findings in `.microcosm/component-guides/`; the linked result below is a historical sample.\n\n## What it checks\n\nA decision can point to a refinement receipt naming an owner and artifact, or to a `nothing_to_refine` receipt with stewardship, next-lane and re-entry checks. The validator resolves those references and checks duplicate IDs. It rejects a landed row with a missing closeout or a dead receipt reference; a local refinement cannot claim global doctrine authority.\n\n## Limits\n\nResolves each landed component's closeout decision to a refinement receipt or a `nothing_to_refine` receipt and checks duplicate IDs, rejecting a missing closeout or a dead receipt reference.\n\n## Verification\n\nThe focused tests exercise this component’s checks; they do not prove its algorithm. `make component-replays` runs its registered exported assimilation bundle through the shared [Dafny admission check](../formal/replay/README.md), which checks source, input, claim-policy and receipt agreement within the host’s observations. The direct command above does not itself invoke that admission gate.\n\n## Source and evidence\n\n- [Implementation](../src/microcosm_core/validators/acceptance.py) and [focused tests](../tests/test_pattern_assimilation_step.py)\n- [Example input](../examples/pattern_assimilation_step/exported_assimilation_bundle) and [historical sample result](../receipts/first_wave/pattern_assimilation_receipt.json)\n- [Component JSON record](./pattern_assimilation.json) and [canonical capsule](../core/paper_module_capsules.json)\n\nFor context see [Hillside patterns](https://hillside.net/patterns/) and [W3C PROV](https://www.w3.org/TR/prov-overview/).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/pattern_assimilation_step/exported_assimilation_bundle_validation_result.json","guide_example":{"command":"PYTHONPATH=src python3 -m microcosm_core.validators.acceptance --only pattern_assimilation_step --input fixtures/first_wave/pattern_assimilation_step/input --out receipts/first_wave/pattern_assimilation_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/pattern_assimilation.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[pattern_assimilation_step].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"exported_assimilation_bundle","input_ref":"examples/pattern_assimilation_step/exported_assimilation_bundle","last_result":{"artifact_ref":"receipts/first_wave/pattern_assimilation_acceptance.json","artifact_sha256":"232b0bbb72cdb1ad2c18eb3cc0c452a00cb1d75d5d87acda7be88516370ea14f","availability":"available","created_at":"2026-06-04T12:37:30+00:00","freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"pattern_assimilation_step","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["plectis","component-replay","p