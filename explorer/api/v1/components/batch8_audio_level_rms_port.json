atus":"not_run_by_index","historical_receipt_refs":["receipts/first_wave/batch8_audio_level_rms_port/batch8_audio_level_rms_port_result.json","receipts/first_wave/batch8_audio_level_rms_port/batch8_audio_level_rms_port_board.json","receipts/first_wave/batch8_audio_level_rms_port/batch8_audio_level_rms_port_validation_receipt.json","receipts/acceptance/first_wave/batch8_audio_level_rms_port_fixture_acceptance.json"],"receipt_time_basis":"historical_saved_artifact"},"formal_subclaim_ids":[],"primary_guide_id":"paper_module.batch8_audio_level_rms_port","primary_guide_ref":"paper_modules/batch8_audio_level_rms_port.md","registered_runner_ref":"src/microcosm_core/organs/batch8_audio_level_rms_port.py","replay_id":"replay::batch8_audio_level_rms_port","requirements_review":{"status":"unrecorded"},"summary":"A Python port computes a normalized RMS level for audio samples.","title":"Calculate a normalized audio level"},"claim_ceiling":"projection mechanics only, not domain correctness","claim_ceiling_restated":"Runs the Python port of the Swift RMS level calculation on the supplied float32 and int16 samples, returning zero for an empty buffer and rejecting an unsupported format with `ValueError`.","claim_id":"claim::batch8_audio_level_rms_port","evidence_class":"algorithmic_projection","evidence_strength_rank":3,"organ_id":"batch8_audio_level_rms_port","truth_accounting_bucket":"source_faithful_refactor","validator_command":"python -m microcosm_core.organs.batch8_audio_level_rms_port run --input fixtures/first_wave/batch8_audio_level_rms_port/input --out receipts/first_wave/batch8_audio_level_rms_port --acceptance-out receipts/acceptance/first_wave/batch8_audio_level_rms_port_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"59dcd28ace8ae81785d87e7b223731e8b19065e6ab3af2f8fd113e5477e6321c","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"algorithmic_projection","family":"import_projection_and_drift","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"source_faithful_refactor"},"component_id":"batch8_audio_level_rms_port","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.batch8_audio_level_rms_port","plain":"A loudness meter must turn many tiny sound measurements into one number, and this component is a rewrite of that calculation in another programming language. It is given lists of sound measurements, stored as decimals or whole numbers, each with the loudness it should give. For each list it squares the measurements, averages them, takes the square root, multiplies by eight and limits the answer to between zero and one, after dividing whole numbers by 32767. An empty list gives zero, an unknown format is rejected, and the output shows whether the rewrite matches the expected levels.","plain_availability":"available","ref":"paper_modules/batch8_audio_level_rms_port.md","sha256":"7372ea8f0fd319d9313d374d787cd4fa20f35b2a35fc88c4233d6ac049924c67","text":"# Calculate a normalized audio level\n\n> **In plain terms.** A loudness meter must turn many tiny sound measurements into one number, and this component is a rewrite of that calculation in another programming language. It is given lists of sound measurements, stored as decimals or whole numbers, each with the loudness it should give. For each list it squares the measurements, averages them, takes the square root, multiplies by eight and limits the answer to between zero and one, after dividing whole numbers by 32767. An empty list gives zero, an unknown format is rejected, and the output shows whether the rewrite matches the expected levels.\n\n`normalized_level` is a Python port of a Swift audio-level calculation. Given float32 samples or int16 samples, it calculates the root mean square, multiplies it by eight and clamps the result to 0–1. Int16 values are divided by 32767. An empty buffer returns zero; an unsupported format raises `ValueError`.\n\nThe fixture compares reference buffers with expected levels. Separate tests generate WAV bytes and check that decoded samples change the result. Its negative cases exercise the empty buffer, an unknown format and values above the clamp. Tests perturb both samples and expected levels to check that the verdict moves.\n\n## Run the example\n\nPython 3.11 or newer and the project test dependencies (install with `python3 -m pip install -e \".[test]\"`) are required. Run from the repository root:\n\n```bash\nPYTHONPATH=src python3 -m microcosm_core.organs.batch8_audio_level_rms_port run \\\n  --input fixtures/first_wave/batch8_audio_level_rms_port/input \\\n  --out .microcosm/component-guides/batch8_audio_level_rms_port \\\n  --acceptance-out .microcosm/component-guides/batch8_audio_level_rms_port/acceptance.json\n```\n\nThe command writes its result and acceptance files under `.microcosm/component-guides/`; inspect the status and findings in those files.\n\n## Verification\n\nThe sample and byte tests do not constitute a formal proof of the audio calculation. Separately, `make component-replays` runs this component’s registered exported-bundle route through the [Dafny-proved replay admission check](../formal/replay/README.md). Using host-supplied observations, it compares source, input, claim-policy and receipt identities; it does not prove the component’s domain result. The direct command above does not invoke the shared check.\n\n## Limits\n\nRuns the Python port of the Swift RMS level calculation on the supplied float32 and int16 samples, returning zero for an empty buffer and rejecting an unsupported format with `ValueError`.\n\n## Sources\n\n[src/microcosm_core/organs/batch8_audio_level_rms_port.py](../src/microcosm_core/organs/batch8_audio_level_rms_port.py) contains the implementation; the [copied Swift source](../examples/batch8_audio_level_rms_port/exported_batch8_audio_level_rms_port_bundle/source_modules/apps/demo-take-console/Sources/DemoTakeConsoleApp/AudioLevelMonitor.swift) supplies the original formula. See the [input fixtures](../fixtures/first_wave/batch8_audio_level_rms_port/input/), [tests](../tests/test_batch8_audio_level_rms_port.py), [historical sample acceptance result](../receipts/acceptance/first_wave/batch8_audio_level_rms_port_fixture_acceptance.json), and the [component JSON record](../core/paper_module_capsules.json). For background on the source platform, see [Apple AVFoundation](https://developer.apple.com/av-foundation/).\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/batch8_audio_level_rms_port/exported_batch8_audio_level_rms_port_bundle_validation_result.json","guide_example":{"command":"microcosm batch8-audio-level-rms-port run --input fixtures/first_wave/batch8_audio_level_rms_port/input --out receipts/first_wave/batch8_audio_level_rms_port --acceptance-out receipts/acceptance/first_wave/batch8_audio_level_rms_port_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/batch8_audio_level_rms_port.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[batch8_audio_level_rms_port].first_command","source_ref