gan_id":"batch7_demo_take_console_capsule","truth_accounting_bucket":"copied_non_secret_macro_body","validator_command":"python -m microcosm_core.organs.batch7_demo_take_console_capsule run --input fixtures/first_wave/batch7_demo_take_console_capsule/input --out receipts/first_wave/batch7_demo_take_console_capsule --acceptance-out receipts/acceptance/first_wave/batch7_demo_take_console_capsule_fixture_acceptance.json"},"claim_clause_coverage":{"claim_text_sha256":"c2f56394640419f4fe68a9f782e38ea966312cc35279b2a2afce740a8116f606","clauses":[],"mapped_clause_count":null,"status":"unknown","whole_claim_coverage":"unknown"},"classification":{"evidence_class":"verified_macro_body_import","family":"import_projection_and_drift","real_substrate_disposition":"real_substrate_capsule","truth_accounting_bucket":"copied_non_secret_macro_body"},"component_id":"batch7_demo_take_console_capsule","evidence_state":{"current_backend_binding":{"status":"not_checked"},"fresh_prover":{"status":"not_recorded_by_index"},"fresh_replay":{"status":"not_recorded_by_index"},"index_state":"retained_generated_snapshot"},"guide":{"availability":"available","guide_id":"paper_module.batch7_demo_take_console_capsule","plain":"A recording app relies on a few small guards in its code, and an edit could remove one unnoticed. Its input is the program code of the Demo Take recording console. It checks the code for guards such as the rule that a recording needs at least one screen, audio or webcam source, confirms that altered copies with a guard removed are rejected, and tries to build the app without launching it. The output is a short summary of each check, which someone can use to see that the guards are still in place.","plain_availability":"available","ref":"paper_modules/batch7_demo_take_console_capsule.md","sha256":"aea81fe2be1c1cb09e89cb2c8de20e0eea5441dcdcc7ebf1bccf9581637ecf1f","text":"# Check Demo Take capture contracts\n\n> **In plain terms.** A recording app relies on a few small guards in its code, and an edit could remove one unnoticed. Its input is the program code of the Demo Take recording console. It checks the code for guards such as the rule that a recording needs at least one screen, audio or webcam source, confirms that altered copies with a guard removed are rejected, and tries to build the app without launching it. The output is a short summary of each check, which someone can use to see that the guards are still in place.\n\nThis fixture checks copied Swift sources for a recording console and exercises a build witness, capture state, helper bridge, hotkey, audio meter and transcription payload contracts. It records summaries rather than source or build-log bodies.\n\n## Run the example\n\nFrom the repository root, with Python 3.11 or newer and the project dependencies installed:\n\n```sh\nPYTHONPATH=src python3 -m microcosm_core.organs.batch7_demo_take_console_capsule run \\\n  --input fixtures/first_wave/batch7_demo_take_console_capsule/input \\\n  --out .microcosm/component-guides/batch7_demo_take_console_capsule/result \\\n  --acceptance-out .microcosm/component-guides/batch7_demo_take_console_capsule/acceptance.json --card\n```\n\nThe command prints a compact JSON card and writes its results under `.microcosm/component-guides/`. A passing run returns exit code 0; a blocked run returns 1.\n\n## What this checks\n\nThe source checks reject mutations that remove the guard requiring at least one screen, audio or webcam source, the required hotkey modifiers, the audio-meter clamp or the transcription audio guard. These are checks of source contracts, not simulated recording actions. A SwiftPM build witness checks that the selected app target builds; it does not launch the app or record a screen.\n\n## Verification\n\nThe example above runs the fixture directly. In `make component-replays`, this component’s exported bundle is checked by the [shared Dafny replay admission core](../formal/replay/README.md) for agreement among supplied source, input, claim-policy and receipt observations. That admission check does not prove this component’s algorithm or the truth of its domain claims.\n\n## Limits\n\nChecks the copied Swift recording-console sources for their capture, hotkey, audio-meter and transcription guards, rejecting mutations that remove them, and builds the selected app target with SwiftPM, which needs Swift and the required Apple frameworks on macOS. SwiftPM writes scratch and cache files under `PLECTIS_SWIFT_BUILD_ROOT`, or the system temporary directory when that variable is unset.\n\n## Source and evidence\n\nRead the [implementation](../src/microcosm_core/organs/batch7_demo_take_console_capsule.py), [fixture input](../fixtures/first_wave/batch7_demo_take_console_capsule/input/batch7_demo_take_console_exercise_manifest.json), and [focused tests](../tests/test_batch7_demo_take_console_capsule.py). The [saved acceptance result](../receipts/acceptance/first_wave/batch7_demo_take_console_capsule_fixture_acceptance.json) is historical sample evidence, not the result of your run. The [JSON record](batch7_demo_take_console_capsule.json) identifies the module; the canonical capsule metadata is in [paper_module_capsules.json](../core/paper_module_capsules.json).\n\n[ScreenCaptureKit](https://developer.apple.com/documentation/ScreenCaptureKit) documents the native capture framework.\n"},"proofs":[],"replay":{"command":"make component-replays","command_ref":"scripts/check/check_component_replays.py","command_scope":"all registered components","configuration_refs":["src/microcosm_core/runtime_shell.py#RUNTIME_STEPS","src/microcosm_core/runtime_shell.py#_accepted_organ_runner_module_refs"],"declared_prerequisites":{"availability_status":"not_assessed_by_index","description":"Lean, Swift and test extras required","source_ref":"Makefile"},"execution_status":"not_run_by_index","fresh_receipt_template":".microcosm/component-replays/<run>/batch7_demo_take_console_capsule/exported_batch7_demo_take_console_capsule_validation_result.json","guide_example":{"command":"PYTHONPATH=src python3 -m microcosm_core.organs.batch7_demo_take_console_capsule run --input fixtures/first_wave/batch7_demo_take_console_capsule/input --out receipts/first_wave/batch7_demo_take_console_capsule --acceptance-out receipts/acceptance/first_wave/batch7_demo_take_console_capsule_fixture_acceptance.json","expected_result_description":{"status":"unrecorded"},"prerequisites_description":{"see":"paper_modules/batch7_demo_take_console_capsule.md","status":"unrecorded"},"scope":"verbatim historical Atlas example; not an execution request and may target retained receipt paths","source_field":"organs[batch7_demo_take_console_capsule].first_command","source_ref":"core/organ_atlas.json","usage":"verbatim_source_example_only","writes_retained_receipts":true},"input_mode":"exported_batch7_demo_take_console_capsule_bundle","input_ref":"examples/batch7_demo_take_console_capsule/exported_batch7_demo_take_console_capsule_bundle","last_result":{"artifact_ref":"receipts/acceptance/first_wave/batch7_demo_take_console_capsule_fixture_acceptance.json","artifact_sha256":"8e8375a33acbfd949d35d93ff10e2cfb247cec99a3d40dc775fb69fa5d0efcd5","availability":"available","created_at":null,"freshness":"historical_saved_artifact","input_mode":null,"native_observations":{"execution_witness_mode":null,"lake_available":null,"lean_available":null,"verification_performed":null},"recorded_source_hashes":{},"recorded_status":"pass","source_binding":"not_checked_against_current_replay"},"last_result_selection":"registry current_authority_receipt; not a search for latest ignored run","native_witness_requested":false,"organ_id":"batch7_demo_take_console_capsule","prerequisites_ref":"Makefile","prerequisites_status":"not_assessed_by_index","primary_execution":{"argv":["plectis","component-replay","batch7_demo_take_console_capsule"],"implementation_state":"companion_external_backend_proposal","input_override_supported":false,"kind":"fixed_compone